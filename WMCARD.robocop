  muzzle     = 31.59, -0.12, 8.89
  barrel     = 1.0000,0.0005,-0.0093

# ESTIMATE, POINT AND SIDE: beside the action, on the side its handle rides.
  ejectport  = 85.37, -3.47, 4.41
