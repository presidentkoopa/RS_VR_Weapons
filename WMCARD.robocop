  # md3_write.extract and re-origined on its centroid. Normals byte-compared
  # against the donor: identical.
  magmodel   = "models/robocop/cobra" "cobra_mag.md3"
  magskin    = "models/robocop/cobra" "cobra_tex.jpg"
  magscale   = 0.340
  magcenter  = -39.09, 0.32, -15.69
end

# THE ACTION (named by prep_wm.py from measured motion, not from the mesh's own label). 28.737 along (-1, 0, 0) at frame 2, 0.00 degrees of turn, fit 0.005.
# the artist called this surface `cobra_barrel`
part bolt
  role       = action
  subject    = slide
  surface    = bolt
  grab       = 31.56, -0.12, 4.45    # the rear end: ESTIMATE, where a hand pulls it
  grabradius = 3.0
  dof
    kind     = slide
    axis     = -1, 0, 0
    distance = 28.737
    detach   = 0.95
  end
end

# THE MAGAZINE (named by prep_wm.py from measured motion, not from the mesh's own label). ESTIMATE, THE AXIS: no frame moves it, so its own long axis (the principal axis of its vertices). MEASURED, THE DIRECTION: the way along that axis that leads away from the body. Distance is its own length along that axis.
part magazine
  role       = feed
  subject    = magazine
  take       = no    # out by its button, in by the hand carrying one
  surface    = mag
  grab       = -24.70, 0.29, -17.91    # the far end along its pull: the floorplate
  grabradius = 3.0
  dof
    kind     = slide
    axis     = 0.9804, 0.0076, -0.1968
    distance = 25.076
    detach   = 0.9
  end
end

# MEASURED: the underside is flat at z -1.16 from x -31.7 to -29.7; its middle. ESTIMATE: where the other hand goes.
part support
  role    = support
  subject = support
  grab       = -30.71, -0.12, -1.16
  grabradius = 3.0
end


# ------------------------------------------------------------------------
# RC_KSG
# ------------------------------------------------------------------------
# MORE THAN ONE TEXTURE ON THIS MESH: ksg_front.png, ksg_back.png
# `skin` names the first; the others are on the mesh's own surfaces.
weapon "RC_KSG"
  hand       = main
  type       = pump
  magfamily  = "12ga"
  drysound   = "robocop/common/dry"
  prop       = "RC_PropKSG"
  mechanism  = pump
  model      = "models/robocop/ksg" "ksg_wm.md3"
  skin       = "models/robocop/ksg" "ksg_front.png"    # the shader this mesh names

  capacity   = 14

# THE MUZZLE: ESTIMATE, WHICH OPENING: the front face (x 35.36) has 2 openings along z (z 5.94..6.19; z 7.00..7.17); the upper one -- a pump's magazine tube runs under its barrel.
  muzzle     = 35.36, 0.00, 7.09
  barrel     = 0.9694,-0.0002,0.2453

# ESTIMATE, POINT AND SIDE: the receiver's +y side behind the forend. Pumps differ -- some eject downward.
  ejectport  = -43.19, 1.00, 0.00
  ejectdir   = -0.3, 0.9, 0.4

# THE SHOT AND THE SOUNDS are the class's and the owner's picks: silent until stated.
  # THE LOOSE SHELL: what the off hand finds in the pouch and pushes
  # through the gate. The shared 12-gauge round the Vanilla pumps use.
  roundmodel = "models/shared/shell" "shell.md3"
  roundskin  = "models/shared/shell" "shell.png"
  roundscale = 0.228
end

# THE FOREND (named by prep_wm.py from measured motion, not from the mesh's own label). STILL: nothing moves it on the donor's frames.
part forend
  subject    = forend
  surface    = forend
  grab       = -33.16, -0.01, -17.44    # the forend's centroid
  grabsize   = 2.0, 2.5, 2.5    # along: half its length in map units; across and up: ESTIMATE, room for a hand
  handseat   = -33.16, -0.01, -19.28    # ESTIMATE: where the hand sits -- the grab-point page trims it
end

# THE TRIGGER. 14.32 degrees about the pin at -8.796, 0.000, -3.530 (frame 4, fit 0.011). Sign checked: +14.32 lands the rest centroid 0.000 off frame 4; -14.32 misses by 1.759.
part trigger
  role    = trigger
  surface = trigger
  dof
    kind    = hinge
    axis    = 0, 1, 0
    degrees = 14.32
    pivot   = -8.796, 0, -3.530
  end
end

# THE TUBE UNDER THE BARREL. The pump archetype feeds from it and the
# gate loads into it; undeclared, both verbs point at nothing.
store tube
  kind     = counted
  capacity = 7
  detach   = no
end

store chamber
  kind  = slotted
  slots = 1
end

# ESTIMATE, THE LOAD GATE: under the receiver behind the forend, one map unit below it, loading upward.
load gate
  at  = -43.19, -0.01, -22.22
  dir = 0, 0, 1
end


