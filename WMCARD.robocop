# ==========================================================================
# ROBOCOP RETRIBUTION -- OCP's hardware -- carded.
#
# GENERATED. Edit the pipeline, never this file:
#   1. rebuild/prep_wm.py       _wm copies at each gun's own REST frame, every
#                               moving surface named into card_skeleton's vocabulary
#   2. rebuild/measure_all.py   tools/card_skeleton.py measures them
#   3. rebuild/assemble.py      chooses, on those measurements, and writes this
#
# PARTS ARE ADDRESSED BY NAME, because step 1 names every surface. An earlier
# attempt addressed them by INDEX and silently bound nothing on any of the sixteen.
#
# REST FRAMES ARE NOT FRAME 0 ON THIS SET: most idle at frame 5, the Garand at 4,
# the Kar98 at 7. A number taken at frame 0 is taken in a pose the gun is never in.
#
# HINGES ARE PARTS. A folding stock, a top cover or a break-open barrel turns about
# a pivot inside itself and moves its centre of mass almost not at all, so anything
# that asks "how far did it travel" loses all of them.
#
# EVERY GRAB POINT IS MEASURED, NOT HELD. They are places on a shape until the
# owner puts the gun in a hand.
# ==========================================================================


# ------------------------------------------------------------------------
# RC_Auto9
# ------------------------------------------------------------------------
weapon "RC_Auto9"
  hand       = main
  type       = pistol
  magfamily  = "auto9"
  drysound   = "robocop/common/dry"
  magoutsound = "robocop/auto9/magout"
  prop       = "RC_PropAuto9"
  model      = "models/robocop/auto9" "auto9_wm.md3"
  skin       = "models/robocop/auto9" "auto9.png"    # the shader this mesh names

  capacity   = 50

# THE MUZZLE: the front-most vertices (x 26.59), centred.
  muzzle     = 26.59, -0.11, 2.66
  barrel     = 0.9803,-0.0133,0.1971

# ESTIMATE, POINT AND SIDE: beside the action, on the side its handle rides.
  ejectport  = -4.73, 1.64, 1.27
  ejectdir   = -0.3, 0.9, 0.4

# NO LOOSE MAGAZINE beside the mesh: lift mag out with md3_write.py extract, check its normals, then state
# magmodel, magskin, magscale 0.340 and magcenter -9.89, -0.10, -12.32 here.

# THE SHOT AND THE SOUNDS are the class's and the owner's picks: silent until stated.
  # THE MAGAZINE AS ITS OWN OBJECT, lifted out of this gun's own mesh with
  # md3_write.extract and re-origined on its centroid. Normals byte-compared
  # against the donor: identical.
  magmodel   = "models/robocop/auto9" "auto9_mag.md3"
  magskin    = "models/robocop/auto9" "auto9.png"
  magscale   = 0.340
  magcenter  = -9.89, -0.10, -12.32
end

# THE ACTION (named by prep_wm.py from measured motion, not from the mesh's own label). STILL: nothing moves it on the donor's frames.
# TRAVEL NOT MEASURABLE HERE: the fit found only 1.000 of motion on this part, which is noise rather than a stroke,
# and sweeping it backwards through its own receiver reads as zero.
# 6.784 is the owner's headset-confirmed travel for the same class of action (WM_M4A3 slide),
# carried across rather than invented. It wants his pass on this gun.
part bolt
  role       = action
  subject    = slide
  surface    = bolt
  grab       = -13.01, -0.09, -0.59    # the rear end: ESTIMATE, where a hand pulls it
  grabradius = 3.0
  dof
    kind     = slide
    axis     = -1, 0, 0
    distance = 6.784    # ESTIMATE: no frame moves it
    detach   = 0.95
  end
end

# THE MAGAZINE (named by prep_wm.py from measured motion, not from the mesh's own label). ESTIMATE, THE AXIS: no frame moves it, so its own long axis (the principal axis of its vertices). MEASURED, THE DIRECTION: the way along that axis that leads away from the body. Distance is its own length along that axis.
part magazine
  role       = feed
  subject    = magazine
  take       = no    # out by its button, in by the hand carrying one
  surface    = mag
  grab       = -13.64, 0.13, -14.74    # the far end along its pull: the floorplate
  grabradius = 3.0
  dof
    kind     = slide
    axis     = -0.8201, 0.0091, -0.5722
    distance = 9.052
    detach   = 0.9
  end
end


