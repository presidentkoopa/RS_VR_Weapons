# ------------------------------------------------------------------------
# BW_Shotgun
# ------------------------------------------------------------------------
weapon "BW_Shotgun"
  hand       = main
  type       = pump
  magfamily  = "12ga"
  drysound   = "bwolf/dry"
  loadsound  = "bwolf/trench/reload1"
  rackapexsound = "bwolf/trench/reload2"
  rackresetsound = "bwolf/trench/reload3"
  prop       = "BW_PropShotgun"
  mechanism  = pump
  model      = "models/bwolf/Shotgun" "Shotgun_wm.md3"
  skin       = "models/bwolf/Shotgun" "Shotgun.png"

  capacity   = 8

# THE MUZZLE: the front-most vertices (x 39.75), centred.
  muzzle     = 39.75, 0.06, 2.23
  barrel     = 0.9930,0.0019,0.1177

# ESTIMATE, POINT AND SIDE: beside the round showing in the receiver, on the side its handle rides.
  ejectport  = -11.43, -2.31, 2.21
  ejectdir   = -0.3, -0.9, 0.4

# NO LOOSE MAGAZINE beside the mesh: lift mag out with md3_write.py extract, check its normals, then state
# magmodel, magskin, magscale 0.340 and magcenter -24.82, 0.05, 4.19 here.

# THE SHOT AND THE SOUNDS are the class's and the owner's picks: silent until stated.
  # THE LOOSE SHELL: what the off hand finds in the pouch and pushes
  # through the gate. The shared 12-gauge round the Vanilla pumps use.
  roundmodel = "models/shared/shell" "shell.md3"
  roundskin  = "models/shared/shell" "shell.png"
  roundscale = 0.228
end

# THE FOREND (named by prep_wm.py from measured motion, not from the mesh's own label). 6.900 along (-1, 0, 0) at frame 17, 0.01 degrees of turn, fit 0.011.
# the artist called this surface `pump`
part forend
  subject    = forend
  surface    = forend
  grab       = 12.54, 0.07, -0.99    # the forend's centroid
  grabsize   = 2.8, 2.5, 2.5    # along: half its length in map units; across and up: ESTIMATE, room for a hand
  handseat   = 12.54, 0.07, -3.25    # ESTIMATE: where the hand sits -- the grab-point page trims it
  dof
    kind     = slide
    axis     = -1, 0, 0
    distance = 6.900
  end
end

# THE TUBE UNDER THE BARREL. The pump archetype feeds from it and the
# gate loads into it; undeclared, both verbs point at nothing.
store tube
  kind     = counted
  capacity = 6
  detach   = no
end

store chamber
  kind  = slotted
  slots = 1
end

# ESTIMATE, THE LOAD GATE: under the receiver behind the forend, one map unit below it, loading upward.
load gate
  at  = -0.84, 0.07, -4.57
  dir = 0, 0, 1
end


