# ==========================================================================
# THE BRUTAL WOLFENSTEIN SET -- Brutal Wolfenstein's weapons -- carded.
#
# GENERATED. Edit the pipeline, never this file:
#   1. rebuild/prep_wm.py       _wm copies at each gun's own REST frame, every
#                               moving surface named into card_skeleton's vocabulary
#   2. rebuild/measure_all.py   tools/card_skeleton.py measures them
#   3. rebuild/assemble.py      chooses, on those measurements, and writes this
#
# PARTS ARE ADDRESSED BY NAME, because step 1 names every surface. An earlier
# attempt addressed them by INDEX and silently bound nothing on any of the sixteen.
#
# REST FRAMES ARE NOT FRAME 0 ON THIS SET: most idle at frame 5, the Garand at 4,
# the Kar98 at 7. A number taken at frame 0 is taken in a pose the gun is never in.
#
# HINGES ARE PARTS. A folding stock, a top cover or a break-open barrel turns about
# a pivot inside itself and moves its centre of mass almost not at all, so anything
# that asks "how far did it travel" loses all of them.
#
# EVERY GRAB POINT IS MEASURED, NOT HELD. They are places on a shape until the
# owner puts the gun in a hand.
# ==========================================================================


# ------------------------------------------------------------------------
# BW_1911
# ------------------------------------------------------------------------
weapon "BW_1911"
  hand       = main
  type       = pistol
  magfamily  = "m1911"
  drysound   = "bwolf/dry"
  maginsound = "bwolf/1911/reload2"
  magoutsound = "bwolf/1911/reload1"
  rackresetsound = "bwolf/1911/reload3"
  prop       = "BW_Prop1911"
  model      = "models/bwolf/1911" "1911_wm.md3"
  skin       = "models/bwolf/1911" "1911.png"

  capacity   = 8

# THE MUZZLE: the front-most vertices (x 17.14), centred.
  muzzle     = 17.14, -0.11, 2.72
  barrel     = 0.9476,-0.0085,0.3192

# ESTIMATE, POINT AND SIDE: beside the action, on the side its handle rides.
  ejectport  = 1.24, -1.58, 2.48
  ejectdir   = -0.3, -0.9, 0.4

# The loose magazine beside the mesh; magcenter is the mag surface's centroid in the gun's space.
  magmodel      = "models/bwolf/1911" "1911_mag.md3"
  magskin       = "models/bwolf/1911" "1911.png"
  magscale   = 0.340
  magcenter  = -1.19, -0.07, -2.02

# THE SHOT AND THE SOUNDS are the class's and the owner's picks: silent until stated.
end

# THE ACTION (named by prep_wm.py from measured motion, not from the mesh's own label). 4.000 along (1, 0, 0) at frame 0, 0.00 degrees of turn, fit 0.000.
# the artist called this surface `model`
part bolt
  role       = action
  subject    = slide
  surface    = bolt
  grab       = -8.85, -0.04, 2.28    # the rear end: ESTIMATE, where a hand pulls it
  grabradius = 3.0
  dof
    kind     = slide
    axis     = 1, 0, 0
    distance = 4.000
    detach   = 0.95
  end
end

# THE MAGAZINE (named by prep_wm.py from measured motion, not from the mesh's own label). 3.497 along (-0.3209, 0, -0.9471) at frame 7, 0.02 degrees of turn, fit 0.010. Distance is its own length along that axis.
part magazine
  role       = feed
  subject    = magazine
  take       = no    # out by its button, in by the hand carrying one
  surface    = mag
  grab       = -6.33, -0.11, -10.31    # the far end along its pull: the floorplate
  grabradius = 3.0
  dof
    kind     = slide
    axis     = -0.3209, 0, -0.9471
    distance = 13.121
    detach   = 0.9
  end
end


