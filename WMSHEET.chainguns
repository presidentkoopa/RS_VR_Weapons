# ============================================================================
# RS_VR_Weapons, THE VANILLA SET -- THE CHAINGUN PICKUP'S PAIR -- the Machine Gun's launcher shot in its barrel block (WMSHEET.chainguns).
#
# A weapon sheet says what a gun shoots; its model card (the reload lane's library) says what the gun is. Every
# number here is TODAY'S, copied unchanged from the gun's class Default block (WM_Gun.* properties, lower case),
# its card's capacity / firesfrom / firesound and its second barrel's shot -- so loading these changes no gun.
# Proof: `wm_card check` empty and the `wm_card all` printout unchanged. Written by the weapons lane, 09-14.
# ============================================================================

gun "WM_Chaingun"
  shotspread           = 5.6, 0
  firetics             = 4
  fullauto             = true
  spinuptics           = 10
  spindowntics         = 20
  firstshotsaccurate   = 2
  roundprofile         = "chaingun_556"
  flashprofile         = "chaingun_556"
  ejectaprofile        = "brass_556"
  recoilprofile        = "chaingun_556"
  firesfrom            = reserve
  firesound            = "wm/chaingun/fire"
  # ---- WEIGHT ----------------------------------------------------------------
  # ANALOGUE: the POUND is measured, the PAIRING is a judgement. an M134-class 5.56 rotary -- tiny
  # per shot because the gun is enormous
  # Argue with the pairing, not the number -- if this is the wrong real-world gun to stand in for,
  # say so and the weight follows.
  # No ammunition subtracted: this gun's card states no capacity, so 35.00 lb is the figure as
  # given and may still carry a load.
  baseweight           = 35.00
end

gun "WM_MachineGun"
  shotspread           = 5.6, 0
  firetics             = 4
  fullauto             = true
  firstshotsaccurate   = 2
  roundprofile         = "machinegun_762"
  flashprofile         = "machinegun_762"
  altflashprofile      = "launcher_40mm"
  ejectaprofile        = "brass_762"
  recoilprofile        = "machinegun_762"
  altrecoilprofile     = "launcher_40mm"
  firesfrom            = reserve
  firesound            = "wm/machinegun/fire"
  barrel launcher
    shotclass          = "WM_LauncherGrenade"
    ammo               = "RSVG_Ammo"
    firesound          = "wm/ubl/fire"
  end
  # ---- WEIGHT ----------------------------------------------------------------
  # ANALOGUE: the POUND is measured, the PAIRING is a judgement. an M60-class 7.62 belt gun
  # Argue with the pairing, not the number -- if this is the wrong real-world gun to stand in for,
  # say so and the weight follows.
  # No ammunition subtracted: this gun's card states no capacity, so 25.00 lb is the figure as
  # given and may still carry a load.
  baseweight           = 25.00
end
