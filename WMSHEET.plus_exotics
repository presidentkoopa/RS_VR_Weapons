gun "WM_VP_LongbarChainsaw"
  model                = WM_LongbarChainsaw
  class
    slot               = 1
    selectionorder     = 2210
    hand               = main
    name               = "Longbar Chainsaw"
    pickupmessage      = "Longbar Chainsaw"
  end
  # NO ammo, like every other saw in the family: Doom's own chainsaw declares no AmmoType either.
  shotsaw              = yes
  firetics             = 4
  # BALLISTICS (RS_Ballistics 988C9E3). The SAME profiles its Vanilla original names --
  # they are the same gun, and a difference between them would be a bug, not a feature.
  # No roundprofile and no ejectaprofile: it fires a shotclass rather than a cartridge,
