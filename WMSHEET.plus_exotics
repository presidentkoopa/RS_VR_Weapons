    slot               = 3
    selectionorder     = 1320
    ammo               = "Shell"
    hand               = main
    name               = "Assault Shotgun"
    pickupmessage      = "Assault shotgun"
  end
  shotpellets          = 7
  shotspread           = 5.6, 0
  firetics             = 28
  # BALLISTICS (RS_Ballistics 988C9E3). The SAME profiles its Vanilla original names --
  # they are the same gun, and a difference between them would be a bug, not a feature.
  flashprofile         = "shotgun_assault"
  recoilprofile        = "shotgun_assault"
  ejectaprofile        = "hull_12ga"
  roundprofile         = "buckshot"
end

