# ============================================================================
# RS_VR_Weapons, VANILLA+ -- THE SHOTGUNS (WMSHEET.plus_shotguns).
#
# The owner, 09-14: Vanilla+ is its own player class (New Game, choose class). Its versions of the Vanilla guns are
# NOT clones: each is its own gun, only this Weapon Card, starting from the Vanilla gun's numbers, to be tuned three at
# a time -- damage, fire rate, secondary fires. `model =` borrows the Vanilla gun's Model Card (the gun gets its own
# copy of it); the `class` block is the class writer's (_pending/tools/make_gun_classes.py), which writes the gun's
# ZScript class on every build. A number changed here changes only the Vanilla+ gun. Copied from WMSHEET.shotguns,
# the weapons lane, 09-14.
# ============================================================================

gun "WM_VP_PumpM37"
  model                = WM_PumpM37
  class
    slot               = 3
    selectionorder     = 1300
    ammo               = "Shell"
    hand               = main
    name               = "Steelgun"
    pickupmessage      = "Steelgun"
  end
  shotpellets          = 7
  shotspread           = 5.6, 0
  roundprofile         = "buckshot"
  flashprofile         = "shotgun_m37"
  ejectaprofile        = "hull_12ga"
  recoilprofile        = "shotgun_m37"
  capacity             = 8
  firesound            = "wm/shotgun/m37_fire"
  altmode              = slamfire
  spreadshape          = cone
  # ---- WEIGHT ----------------------------------------------------------------
  # ANALOGUE: the POUND is measured, the PAIRING is a judgement. Ithaca 37 -- the gun is literally
  # named after it
  # Argue with the pairing, not the number -- if this is the wrong real-world gun to stand in for,
  # say so and the weight follows.
  # EMPTY, NOT LOADED. 6.50 lb loaded less 8 rounds of 12 gauge 00 buck at 0.0991 lb each. A
  # magazine is not a rounding error -- a PPSh's 71-round drum is a seventh of the gun.
  baseweight           = 5.71
end

