gun "HX_Zooka"
  class
    slot               = 5
    selectionorder     = 9570
    ammo               = "RocketAmmo"
    hand               = main
    name               = "Zooka"
    pickupmessage      = "Zooka"
  end
  firesound            = "hacx/zooka/fire"
  # Four in the tube, at a launcher's pace. A launcher that fires fast is a plasma gun.
  firetics             = 22
  shotclass            = "Rocket"
  flashprofile         = "rocket_launcher"
  recoilprofile        = "rocket_launcher"
end

gun "HX_Nuker"
  class
    slot               = 8
    selectionorder     = 9870
    ammo               = "Cell"
    hand               = main
    name               = "Nuker"
    pickupmessage      = "Nuker"
  end
  firesound            = "hacx/nuker/fire"
