# ============================================================================
# RS_VR_Weapons, THE VANILLA SET -- THE PISTOLS -- the Pistol pickup's pair (WMSHEET.pistols).
#
# A weapon sheet says what a gun shoots; its model card (the reload lane's library) says what the gun is. Every
# number here is TODAY'S, copied unchanged from the gun's class Default block (WM_Gun.* properties, lower case),
# its card's capacity / firesfrom / firesound and its second barrel's shot -- so loading these changes no gun.
# Proof: `wm_card check` empty and the `wm_card all` printout unchanged. Written by the weapons lane, 09-14.
# ============================================================================

gun "WM_M4A3"
  roundprofile         = "pistol_45"
  flashprofile         = "pistol_45"
  ejectaprofile        = "brass_45"
  recoilprofile        = "pistol_45"
  capacity             = 15
  firesound            = "wm/m4a3/fire"
  # ---- WEIGHT ----------------------------------------------------------------
  # ANALOGUE: the POUND is measured, the PAIRING is a judgement. M1911 -- a .45 service automatic,
  # which is what pistol_45 says it is
  # Argue with the pairing, not the number -- if this is the wrong real-world gun to stand in for,
  # say so and the weight follows.
  # EMPTY, NOT LOADED. 2.70 lb loaded less 15 rounds of .45 ACP at 0.0463 lb each. A magazine is
  # not a rounding error -- a PPSh's 71-round drum is a seventh of the gun.
  baseweight           = 2.01
end

gun "WM_Pistolet"
  roundprofile         = "pistol_9mm"
  flashprofile         = "pistol_9mm"
  ejectaprofile        = "brass_9mm_pistolet"
  recoilprofile        = "pistol_9mm"
  capacity             = 15
  firesound            = "wm/pistolet/fire"
  # ---- WEIGHT ----------------------------------------------------------------
  # ANALOGUE: the POUND is measured, the PAIRING is a judgement. Beretta 92FS -- the owner's own
  # call, and Doom's pistol has always been one
  # Argue with the pairing, not the number -- if this is the wrong real-world gun to stand in for,
  # say so and the weight follows.
  # EMPTY, NOT LOADED. 2.30 lb loaded less 15 rounds of 9x19 / 5.56x45 at 0.0271 lb each. A
  # magazine is not a rounding error -- a PPSh's 71-round drum is a seventh of the gun.
  baseweight           = 1.89
end
