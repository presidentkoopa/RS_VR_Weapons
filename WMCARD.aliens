# ==========================================================================
# ALIENS ERADICATION -- the Colonial Marines' guns -- carded.
#
# GENERATED. Edit the pipeline, never this file:
#   1. rebuild/prep_wm.py       _wm copies at each gun's own REST frame, every
#                               moving surface named into card_skeleton's vocabulary
#   2. rebuild/measure_all.py   tools/card_skeleton.py measures them
#   3. rebuild/assemble.py      chooses, on those measurements, and writes this
#
# PARTS ARE ADDRESSED BY NAME, because step 1 names every surface. An earlier
# attempt addressed them by INDEX and silently bound nothing on any of the sixteen.
#
# REST FRAMES ARE NOT FRAME 0 ON THIS SET: most idle at frame 5, the Garand at 4,
# the Kar98 at 7. A number taken at frame 0 is taken in a pose the gun is never in.
#
# HINGES ARE PARTS. A folding stock, a top cover or a break-open barrel turns about
# a pivot inside itself and moves its centre of mass almost not at all, so anything
# that asks "how far did it travel" loses all of them.
#
# EVERY GRAB POINT IS MEASURED, NOT HELD. They are places on a shape until the
# owner puts the gun in a hand.
# ==========================================================================


# ------------------------------------------------------------------------
# AE_Knife
# ------------------------------------------------------------------------
weapon "AE_Knife"
  hand       = main
  type       = melee
  firesfrom  = none
  prop       = "AE_PropKnife"
  model      = "models/aliens/knife" "knife_wm.md3"
  skin       = "models/aliens/knife" "knife.png"    # the shader this mesh names



# THE SHOT AND THE SOUNDS are the class's and the owner's picks: silent until stated.
end

# NO PARTS. This weapon has no ammunition and nothing a hand works;
# what moves on its mesh is the whole weapon swinging or being thrown.


# ------------------------------------------------------------------------
# AE_Flamer
# ------------------------------------------------------------------------
weapon "AE_Flamer"
  hand       = main
  type       = flamer
  magfamily  = "m260b_tank"
  drysound   = "aliens/common/dryfire"
  maginsound = "aliens/m260b/reload2"
  magoutsound = "aliens/m260b/reload1"
  rackresetsound = "aliens/m260b/reload3"
  prop       = "AE_PropFlamer"
  model      = "models/aliens/m260b" "m260b_wm.md3"
  skin       = "models/aliens/m260b" "m260b.png"    # the shader this mesh names

  capacity   = 100
  firesfrom  = magazine    # fired straight from the magazine: nothing racks
  casing     = none    # ESTIMATE: nothing racks, so nothing is thrown out

# THE MUZZLE: the front-most vertices (x 42.92), centred.
  muzzle     = 42.92, -0.94, -1.59
  barrel     = 0.9991,0.0160,-0.0384

# The loose magazine beside the mesh; magcenter is the mag surface's centroid in the gun's space.
  magmodel      = "models/aliens/m260b" "m260b_mag.md3"
  magskin       = "models/aliens/m260b" "m260b.png"    # the shader this mesh names
  magscale   = 0.340
  magcenter  = -9.81, -0.49, -10.24

# THE SHOT AND THE SOUNDS are the class's and the owner's picks: silent until stated.
end

# THE MAGAZINE (named by prep_wm.py from measured motion, not from the mesh's own label). THE AXIS IS MEASURED: no single slide or hinge fits the whole stroke (the magazine tilts as it leaves), so the axis is the direction its centre actually travelled by frame 11. Distance is its own length along that axis.
# the artist called this surface `m260b_canister`
part magazine
  role       = feed
  subject    = magazine
  take       = no    # out by its button, in by the hand carrying one
  surface    = mag
  grab       = -9.38, 3.88, -27.66    # the far end along its pull: the floorplate
  grabradius = 3.0
  dof
    kind     = slide
    axis     = 0.0909, 0.5148, -0.8525
    distance = 27.268
    detach   = 0.9
  end
end

# THE TRIGGER. 16.69 degrees about the pin at -29.305, 0.000, -2.351 (frame 1, fit 0.012). Sign checked: +16.69 lands the rest centroid 0.000 off frame 1; -16.69 misses by 4.094.
# the artist called this surface `m260b_trigger`
part trigger
  role    = trigger
  surface = trigger
  dof
    kind    = hinge
    axis    = 0, 1, 0
    degrees = 16.69
    pivot   = -29.305, 0, -2.351
  end
end

# MEASURED: the underside is flat at z -0.66 from x -12.3 to -7.1; its middle. ESTIMATE: where the other hand goes.
part support
  role    = support
  subject = support
  grab       = -9.72, -0.43, -0.66
  grabradius = 3.0
end


# ------------------------------------------------------------------------
# AE_M37A2
# ------------------------------------------------------------------------
# MORE THAN ONE TEXTURE ON THIS MESH: m37a2.png, shotgun_shell.png
# `skin` names the first; the others are on the mesh's own surfaces.
weapon "AE_M37A2"
  hand       = main
  type       = pump
  magfamily  = "12ga"
  cyclehomesound = "aliens/m37a2/pump"
  cycleoutsound = "aliens/m37a2/pump"
  drysound   = "aliens/common/dryfire"
  loadsound  = "aliens/m37a2/shellin"
  prop       = "AE_PropM37A2"
  mechanism  = pump
  model      = "models/aliens/m37a2" "m37a2_wm.md3"
  skin       = "models/aliens/m37a2" "m37a2.png"    # the shader this mesh names

  capacity   = 6

# THE MUZZLE: the front-most vertices (x 38.34), centred.
  muzzle     = 38.34, -0.20, 3.52
  barrel     = 0.9964,-0.0018,0.0850

# ESTIMATE, POINT AND SIDE: the receiver's +y side behind the forend. Pumps differ -- some eject downward.
  ejectport  = 4.75, 1.00, 0.00
  ejectdir   = -0.3, 0.9, 0.4

# THE SHOT AND THE SOUNDS are the class's and the owner's picks: silent until stated.
  # THE LOOSE SHELL: what the off hand finds in the pouch and pushes
  # through the gate. The shared 12-gauge round the Vanilla pumps use.
  roundmodel = "models/shared/shell" "shell.md3"
  roundskin  = "models/shared/shell" "shell.png"
  roundscale = 0.228
end

# THE FOREND (named by prep_wm.py from measured motion, not from the mesh's own label). 11.202 along (-1, 0, 0) at frame 26, 0.02 degrees of turn, fit 0.015.
# the artist called this surface `m37a2_pump`
part forend
  subject    = forend
  surface    = forend
  grab       = 19.20, -0.20, 0.17    # the forend's centroid
  grabsize   = 3.1, 2.5, 2.5    # along: half its length in map units; across and up: ESTIMATE, room for a hand
  handseat   = 19.20, -0.20, -2.42    # ESTIMATE: where the hand sits -- the grab-point page trims it
  dof
    kind     = slide
    axis     = -1, 0, 0
    distance = 11.202
  end
end

# THE TRIGGER. 31.11 degrees about the pin at -17.882, 0.000, -1.114 (frame 2, fit 0.012). Sign checked: +31.11 lands the rest centroid 0.000 off frame 2; -31.11 misses by 2.277.
# the artist called this surface `m37a2_trigger`
part trigger
  role    = trigger
  surface = trigger
  dof
    kind    = hinge
    axis    = 0, 1, 0
    degrees = 31.11
    pivot   = -17.882, 0, -1.114
  end
end

# THE TUBE UNDER THE BARREL. The pump archetype feeds from it and the
# gate loads into it; undeclared, both verbs point at nothing.
store tube
  kind     = counted
  capacity = 5
  detach   = no
end

store chamber
  kind  = slotted
  slots = 1
end

# ESTIMATE, THE LOAD GATE: under the receiver behind the forend, one map unit below it, loading upward.
load gate
  at  = 4.75, -0.20, -5.36
  dir = 0, 0, 1
end


