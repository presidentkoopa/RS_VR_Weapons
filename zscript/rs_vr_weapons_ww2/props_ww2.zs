// ==========================================================================
// THE WW2 SET'S PROPS -- one per gun, the actor its card names.
//
// A prop is a drawing: MODELDEF binds the mesh to it and the renderer rides it on the
// controller. It carries no behaviour, which is why sixteen of them are sixteen lines.
// ==========================================================================
class WW2_Prop : WM_Prop {}

class WW2_Prop1911 : WW2_Prop {}
class WW2_PropLuger : WW2_Prop {}
class WW2_PropShotgun : WW2_Prop {}
class WW2_PropMP40 : WW2_Prop {}
class WW2_PropTommy : WW2_Prop {}
class WW2_PropPPSh : WW2_Prop {}
class WW2_PropKar98 : WW2_Prop {}
class WW2_PropGarand : WW2_Prop {}
class WW2_PropSTG44 : WW2_Prop {}
class WW2_PropBAR : WW2_Prop {}
class WW2_PropMG42 : WW2_Prop {}
class WW2_PropChaingun : WW2_Prop {}
class WW2_PropKnife : WW2_Prop {}
class WW2_PropAxe : WW2_Prop {}
class WW2_PropFlamethrower : WW2_Prop {}
class WW2_PropGrenade : WW2_Prop {}
class WW2_PropP38 : WW2_Prop {}
class WW2_PropNebelwerfer : WW2_Prop {}
