// ==========================================================================
// THE WW2 SET'S PROPS -- one per gun, the actor its card names.
//
// A prop is a drawing: MODELDEF binds the mesh to it and the renderer rides it on the
// controller. It carries no behaviour, which is why sixteen of them are sixteen lines.
// ==========================================================================
class BW_Prop : WM_Prop {}

class BW_Prop1911 : BW_Prop {}
class BW_PropLuger : BW_Prop {}
class BW_PropShotgun : BW_Prop {}
class BW_PropMP40 : BW_Prop {}
class BW_PropTommy : BW_Prop {}
class BW_PropPPSh : BW_Prop {}
class BW_PropKar98 : BW_Prop {}
class BW_PropGarand : BW_Prop {}
class BW_PropSTG44 : BW_Prop {}
class BW_PropBAR : BW_Prop {}
class BW_PropMG42 : BW_Prop {}
class BW_PropChaingun : BW_Prop {}
class BW_PropKnife : BW_Prop {}
class BW_PropAxe : BW_Prop {}
class BW_PropFlamethrower : BW_Prop {}
class BW_PropGrenade : BW_Prop {}
class BW_PropP38 : BW_Prop {}
class BW_PropNebelwerfer : BW_Prop {}
