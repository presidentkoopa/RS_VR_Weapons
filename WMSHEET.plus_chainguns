  roundprofile         = "chaingun_556"
  flashprofile         = "chaingun_556"
  ejectaprofile        = "brass_556"
  recoilprofile        = "chaingun_556"
  firesfrom            = reserve
  firesound            = "wm/chaingun/fire"
end

