# ============================================================================
# RS_VR_Weapons, THE VANILLA SET -- THE SHOTGUNS -- the Shotgun pickup's pair and the Super Shotgun pickup's pair (WMSHEET.shotguns).
#
# A weapon sheet says what a gun shoots; its model card (the reload lane's library) says what the gun is. Every
# number here is TODAY'S, copied unchanged from the gun's class Default block (WM_Gun.* properties, lower case),
# its card's capacity / firesfrom / firesound and its second barrel's shot -- so loading these changes no gun.
# Proof: `wm_card check` empty and the `wm_card all` printout unchanged. Written by the weapons lane, 09-14.
# ============================================================================

gun "WM_PumpM37"
  shotpellets          = 7
  shotspread           = 5.6, 0
  roundprofile         = "buckshot"
  flashprofile         = "shotgun_m37"
  ejectaprofile        = "hull_12ga"
  recoilprofile        = "shotgun_m37"
  capacity             = 8
  firesound            = "wm/shotgun/m37_fire"
  # ---- WEIGHT ----------------------------------------------------------------
  # ANALOGUE: the POUND is measured, the PAIRING is a judgement. Ithaca 37 -- the gun is literally
  # named after it
  # Argue with the pairing, not the number -- if this is the wrong real-world gun to stand in for,
  # say so and the weight follows.
  # EMPTY, NOT LOADED. 6.50 lb loaded less 8 rounds of 12 gauge 00 buck at 0.0991 lb each. A
  # magazine is not a rounding error -- a PPSh's 71-round drum is a seventh of the gun.
  baseweight           = 5.71
end

gun "WM_PumpDoom"
  shotpellets          = 7
  shotspread           = 5.6, 0
  roundprofile         = "buckshot"
  flashprofile         = "shotgun_doom"
  ejectaprofile        = "hull_12ga"
  recoilprofile        = "shotgun_doom"
  capacity             = 8
  firesound            = "weapons/shotgf"
  # ---- WEIGHT ----------------------------------------------------------------
  # ANALOGUE: the POUND is measured, the PAIRING is a judgement. a generic riot pump, heavier than
  # the Ithaca
  # Argue with the pairing, not the number -- if this is the wrong real-world gun to stand in for,
  # say so and the weight follows.
  # EMPTY, NOT LOADED. 7.00 lb loaded less 8 rounds of 12 gauge 00 buck at 0.0991 lb each. A
  # magazine is not a rounding error -- a PPSh's 71-round drum is a seventh of the gun.
  baseweight           = 6.21
end

gun "WM_SSG"
  shotpellets          = 10
  shotspread           = 11.25, 7.097
  firetics             = 20
  chambersperpull      = 2
  roundprofile         = "buckshot_magnum"
  flashprofile         = "shotgun_ssg"
  ejectaprofile        = "hull_12ga_magnum"
  recoilprofile        = "shotgun_ssg"
  capacity             = 2
  firesound            = "weapons/sshotf"
  # ---- WEIGHT ----------------------------------------------------------------
  # ANALOGUE: the POUND is measured, the PAIRING is a judgement. a sawn-off double fired with BOTH
  # BARRELS -- twice the payload and twice the charge, which is why it is the hardest-kicking thing
  # in the game
  # Argue with the pairing, not the number -- if this is the wrong real-world gun to stand in for,
  # say so and the weight follows.
  # EMPTY, NOT LOADED. 7.00 lb loaded less 2 rounds of 12 gauge 00 buck at 0.0991 lb each. A
  # magazine is not a rounding error -- a PPSh's 71-round drum is a seventh of the gun.
  baseweight           = 6.80
end

gun "WM_BullpupPump"
  shotpellets          = 20
  shotspread           = 11.25, 7.097
  roundprofile         = "buckshot_magnum"
  flashprofile         = "shotgun_bullpup"
  ejectaprofile        = "hull_12ga_magnum"
  recoilprofile        = "shotgun_bullpup"
  capacity             = 4
  firesound            = "wm/shotgun/bullpup_fire"
  # ---- WEIGHT ----------------------------------------------------------------
  # ANALOGUE: the POUND is measured, the PAIRING is a judgement. a bullpup magazine shotgun, twenty
  # pellets: more payload again, in a heavier gun
  # Argue with the pairing, not the number -- if this is the wrong real-world gun to stand in for,
  # say so and the weight follows.
  # EMPTY, NOT LOADED. 8.40 lb loaded less 4 rounds of 12 gauge 00 buck at 0.0991 lb each. A
  # magazine is not a rounding error -- a PPSh's 71-round drum is a seventh of the gun.
  baseweight           = 8.00
end
