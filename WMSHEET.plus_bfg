# ============================================================================
# RS_VR_Weapons, VANILLA+ -- THE BFGS (WMSHEET.plus_bfg).
#
# The owner, 09-14: Vanilla+ is its own player class (New Game, choose class). Its versions of the Vanilla guns are
# NOT clones: each is its own gun, only this Weapon Card, starting from the Vanilla gun's numbers, to be tuned three at
# a time -- damage, fire rate, secondary fires. `model =` borrows the Vanilla gun's Model Card (the gun gets its own
# copy of it); the `class` block is the class writer's (_pending/tools/make_gun_classes.py), which writes the gun's
# ZScript class on every build. A number changed here changes only the Vanilla+ gun. Copied from WMSHEET.bfg,
# the weapons lane, 09-14.
# ============================================================================

gun "WM_VP_BFG"
  model                = WM_BFG
  class
    slot               = 0
    selectionorder     = 2800
    ammo               = "Cell"
    hand               = main
    name               = "BFG 9000"
    pickupmessage      = "BFG 9000"
  end
  firetics             = 10
  fullauto             = true
  roundspershot        = 40
  shotclass            = "RSB_BFGBall"
  chargetics           = 30
  chargesound          = "weapons/bfgf"
  releasetics          = 20
  flashprofile         = "bfg_9000"
  capacity             = 160
  firesfrom            = magazine
  spreadshape          = cone
  recoilprofile        = "bfg_9000"
end

gun "WM_VP_BFGHeavy"
  model                = WM_BFGHeavy
  class
    slot               = 0
    selectionorder     = 9800
    ammo               = "Cell"
    hand               = off
    name               = "BFG 10000"
    pickupmessage      = "BFG 10000"
  end
  firetics             = 10
  fullauto             = true
  roundspershot        = 40
  shotclass            = "RSB_BFGBallHeavy"
  chargetics           = 30
  chargesound          = "weapons/bfgf"
  releasetics          = 20
  flashprofile         = "bfg_heavy"
  capacity             = 160
  firesfrom            = magazine
  spreadshape          = cone
  recoilprofile        = "bfg_heavy"
end
