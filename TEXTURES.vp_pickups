// ============================================================================
// RS_VR_Weapons -- VANILLA+'S FLOOR PICKUPS (the owner, 09-15: "take them from RS Main"). One sprite per Vanilla+
// gun family, RS_Main's RS_GH pickup art (graphics/vp_pickups, frame A, unchanged), SCALED to a Doom pickup's size --
// the art is icon-sized -- and OFFSET bottom-centre so it stands on the floor. WM_PairPickup (weaponset.zs) draws
// these, and only for a Vanilla+ viewer. Written by the weapons lane's vp_pickup_sprites.py.
// ============================================================================

// gh_pistol: 200 x 150, small -- about 19 x 14 units
Sprite "VPPSA0", 200, 150
{
	XScale 10.714
	YScale 10.714
	Offset 100, 150
	Patch "graphics/vp_pickups/HBPSA0.png", 0, 0
}

