# ------------------------------------------------------------------------
# CL_PlasmaGun
# ------------------------------------------------------------------------
# MORE THAN ONE TEXTURE ON THIS MESH: rifle.png, heat.png
# `skin` names the first; the others are on the mesh's own surfaces.
weapon "CL_PlasmaGun"
  hand       = main
  type       = plasma
  magfamily  = "cell"
  drysound   = "cola/common/dryfire"
  prop       = "CL_PropPlasmaGun"
  model      = "models/cola/plasmagun" "plasmagun_wm.md3"
  skin       = "models/cola/plasmagun" "rifle.png"    # the shader this mesh names

  capacity   = 40
  firesfrom  = magazine    # fired straight from the magazine: nothing racks
  casing     = none    # ESTIMATE: nothing racks, so nothing is thrown out

# THE MUZZLE: the front-most vertices (x 18.61), centred.
  muzzle     = 18.61, 0.01, -7.12
  barrel     = 0.9997,0.0015,0.0251

# NO LOOSE MAGAZINE beside the mesh: lift mag out with md3_write.py extract, check its normals, then state
# magmodel, magskin, magscale 0.340 and magcenter 3.45, 0.04, 3.07 here.

# THE SHOT AND THE SOUNDS are the class's and the owner's picks: silent until stated.
  # THE MAGAZINE AS ITS OWN OBJECT, lifted out of this gun's own mesh with
  # md3_write.extract and re-origined on its centroid. Normals byte-compared
  # against the donor: identical.
  magmodel   = "models/cola/plasmagun" "plasmagun_mag.md3"
  magskin    = "models/cola/plasmagun" "rifle.png"
  magscale   = 0.340
  magcenter  = 3.45, 0.04, 3.07
end

# THE MAGAZINE (named by prep_wm.py from measured motion, not from the mesh's own label). ESTIMATE, THE AXIS: no frame moves it, so its own long axis (the principal axis of its vertices). MEASURED, THE DIRECTION: the way along that axis that leads away from the body. Distance is its own length along that axis.
# the artist called this surface `heat1`
part magazine
  role       = feed
  subject    = magazine
  take       = no    # out by its button, in by the hand carrying one
  surface    = mag
  grab       = 17.52, 0.05, 0.69    # the far end along its pull: the floorplate
  grabradius = 3.0
  dof
    kind     = slide
    axis     = 0.9979, 0.0012, -0.0641
    distance = 32.223
    detach   = 0.9
  end
end

# THE TRIGGER. 3.88 degrees about the pin at -4.149, 1.326, -2.786 (frame 2, fit 0.439). Sign checked: +3.88 lands the rest centroid 0.000 off frame 2; -3.88 misses by 0.107. REVIEW: worst fit 0.439 -- it does not move as one rigid piece on every frame.
# the artist called this surface `wheel_thingy`
part trigger
  role    = trigger
  surface = trigger
  dof
    kind    = hinge
    axis    = 0.2101, -0.9609, 0.1806
    degrees = 3.88
    pivot   = -4.149, 1.326, -2.786
  end
end

# MEASURED: the underside is flat at z -4.70 from x 13.4 to 16.2; its middle. ESTIMATE: where the other hand goes.
part support
  role    = support
  subject = support
  grab       = 14.79, 0.01, -4.70
  grabradius = 3.0
end


