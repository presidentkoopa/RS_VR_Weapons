# ------------------------------------------------------------------------
# CL_KS23
# ------------------------------------------------------------------------
# MORE THAN ONE TEXTURE ON THIS MESH: shotgun.png, shotgun_shell.png
# `skin` names the first; the others are on the mesh's own surfaces.
weapon "CL_KS23"
  hand       = main
  type       = pump
  magfamily  = "12ga"
  cyclehomesound = "cola/ks23/pumpfwd"
  cycleoutsound = "cola/ks23/pumpback"
  drysound   = "cola/common/dryfire"
  loadsound  = "cola/ks23/load"
  prop       = "CL_PropKS23"
  mechanism  = pump
  model      = "models/cola/shotgun" "shotgun_wm.md3"
  skin       = "models/cola/shotgun" "shotgun.png"    # the shader this mesh names

  capacity   = 5

# THE MUZZLE: the front-most vertices (x 39.83), centred.
  muzzle     = 39.83, 0.01, 3.02
  barrel     = 0.9967,0.0011,0.0806

# ESTIMATE, POINT AND SIDE: beside the action, on the side its handle rides.
  ejectport  = 4.22, -2.16, 3.51
  ejectdir   = -0.3, -0.9, 0.4

# NO LOOSE MAGAZINE beside the mesh: lift mag out with md3_write.py extract, check its normals, then state
# magmodel, magskin, magscale 0.340 and magcenter -11.05, -0.01, -3.84 here.

# THE SHOT AND THE SOUNDS are the class's and the owner's picks: silent until stated.
  # THE LOOSE SHELL: what the off hand finds in the pouch and pushes
  # through the gate. The shared 12-gauge round the Vanilla pumps use.
  roundmodel = "models/shared/shell" "shell.md3"
  roundskin  = "models/shared/shell" "shell.png"
  roundscale = 0.228
end

# THE FOREND (named by prep_wm.py from measured motion, not from the mesh's own label). 6.657 along (-1, 0, 0) at frame 8, 0.00 degrees of turn, fit 0.008.
# the artist called this surface `pump`
part forend
  subject    = forend
  surface    = forend
  grab       = 9.33, -0.01, 0.97    # the forend's centroid
  grabsize   = 6.5, 2.5, 2.5    # along: half its length in map units; across and up: ESTIMATE, room for a hand
  handseat   = 9.33, -0.01, -3.45    # ESTIMATE: where the hand sits -- the grab-point page trims it
  dof
    kind     = slide
    axis     = -1, 0, 0
    distance = 6.657
  end
end

# THE TUBE UNDER THE BARREL. The pump archetype feeds from it and the
# gate loads into it; undeclared, both verbs point at nothing.
store tube
  kind     = counted
  capacity = 5
  detach   = no
end

store chamber
  kind  = slotted
  slots = 1
end

# ESTIMATE, THE LOAD GATE: under the receiver behind the forend, one map unit below it, loading upward.
load gate
  at  = -10.67, -0.01, -8.07
  dir = 0, 0, 1
end


