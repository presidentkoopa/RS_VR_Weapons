# ------------------------------------------------------------------------
# CL_Jackhammer
# ------------------------------------------------------------------------
# MORE THAN ONE TEXTURE ON THIS MESH: jackhammer.png, gas_label.png, jackhammer_mag.png
# `skin` names the first; the others are on the mesh's own surfaces.
weapon "CL_Jackhammer"
  hand       = main
  type       = pump
  magfamily  = "jackhammer"
  drysound   = "cola/jackhammer/dry"
  maginsound = "cola/jackhammer/load"
  prop       = "CL_PropJackhammer"
  model      = "models/cola/jackhammer" "jackhammer_wm.md3"
  skin       = "models/cola/jackhammer" "jackhammer.png"    # the shader this mesh names

  capacity   = 10

# THE MUZZLE: the front-most vertices (x 44.14), centred.
  muzzle     = 44.14, 1.27, 3.66
  barrel     = 0.9941,-0.0002,0.1089

# ESTIMATE, POINT AND SIDE: beside the action, on the side its handle rides.
  ejectport  = -9.83, -8.22, 4.62
  ejectdir   = -0.3, -0.9, 0.4

# The loose magazine beside the mesh; magcenter is the mag surface's centroid in the gun's space.
  magmodel      = "models/cola/jackhammer" "jackhammer_mag.md3"
  magskin       = "models/cola/jackhammer" "jackhammer.png"    # the shader this mesh names
  magscale   = 0.340
  magcenter  = -16.39, 1.14, -2.49

# THE SHOT AND THE SOUNDS are the class's and the owner's picks: silent until stated.
end

# THE ACTION (named by prep_wm.py from measured motion, not from the mesh's own label). STILL: nothing moves it on the donor's frames.
# TRAVEL NOT MEASURABLE HERE: the fit found only 1.000 of motion on this part, which is noise rather than a stroke,
# and sweeping it backwards through its own receiver reads as zero.
# 10.000 is the owner's headset-confirmed travel for the same class of action (WM_AssaultShotgun charginghandle),
# carried across rather than invented. It wants his pass on this gun.
# the artist called this surface `cylinder`
part bolt
  role       = action
  subject    = slide
  surface    = bolt
  grab       = -10.47, -5.11, 5.03    # the rear end: ESTIMATE, where a hand pulls it
  grabradius = 3.0
  dof
    kind     = slide
    axis     = -1, 0, 0
    distance = 10.000    # ESTIMATE: no frame moves it
    detach   = 0.95
  end
end

# THE MAGAZINE (named by prep_wm.py from measured motion, not from the mesh's own label). 4.972 along (0, -0.0018, -1) at frame 13, 0.03 degrees of turn, fit 0.012. Distance is its own length along that axis.
part magazine
  role       = feed
  subject    = magazine
  take       = no    # out by its button, in by the hand carrying one
  surface    = mag
  grab       = -17.15, 1.02, -8.45    # the far end along its pull: the floorplate
  grabradius = 3.0
  dof
    kind     = slide
    axis     = 0, -0.0018, -1
    distance = 11.245
    detach   = 0.9
  end
end

# MEASURED: the underside is flat at z 5.56 from x 17.4 to 23.6; its middle. ESTIMATE: where the other hand goes.
part support
  role    = support
  subject = support
  grab       = 20.48, 1.27, 5.56
  grabradius = 3.0
end


