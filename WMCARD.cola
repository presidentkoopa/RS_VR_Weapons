# THE ACTION (named by prep_wm.py from measured motion, not from the mesh's own label). 180.00 degrees about the pin at -5.703, 0.000, 0.102 (frame 0, fit 0.000). Sign checked: +180.00 lands the rest centroid 10.264 off frame 0; -180.00 misses by 10.264.
# the artist called this surface `Magazine.wheel`
part bolt3
  role       = action
  subject    = slide
  surface    = bolt3
  grab       = -1.97, 2.82, 0.02    # the handle's tip: its 31 vertices within 0.5 of its outermost
  grabradius = 3.0
