  firesound            = "bwolf/knife/fire"
  # Brutal Wolfenstein II v0.2.5, actors/Weapons/Melee.dec
  # BWII v0.2.5 fires a KnifeAttack projectile, Damage (random(50,50)) -- a flat 50.
  # Swing cycle is 13 tics, 2.7/s. Its altfire punches: MeleeStrike1 5, MeleeStrike2 20,
  # MeleeStrike1Smash 100 under PowerStrength.
