gun "BW_Shotgun"
  class
    slot               = 3
    selectionorder     = 9300
    ammo               = "Shell"
    hand               = main
    name               = "Trench Gun"
    pickupmessage      = "Trench Gun"
  end
  firesound            = "bwolf/trench/fire"
  # Brutal Wolfenstein II v0.2.5, actors/Weapons/Trenchgun.dec
  shotdamage           = 25, 25
  shotpellets          = 7
  shotspread           = 4, 2
  # FIRE CADENCE: the whole animation block that carries the shot, from its label to
  # A_Refire in Brutal Wolfenstein II's own state table. NOT the frame that fires: the
  # flash frame ahead of the bullet is part of the cycle, and counting from A_FireBullets
  # alone puts the MP40 at 11.7 shots a second against a real 500 rpm of 8.3. Counting the
  # block gives 8.75, and the Thompson lands on 11.7 against a real 700 rpm of 11.7.
  firetics             = 12
  # ALT-FIRE. SLAM-FIRE, AND IT IS THE GUN'S WHOLE IDENTITY. The M1897 trench gun has no trigger
  # disconnector: hold the trigger down, work the pump, and it fires on every stroke. That is
  # the thing it is famous for and we already have the altmode for it.
  altmode              = slamfire
  # BALLISTICS (RS_Ballistics d1b4c06). flash, recoil and ejecta are this gun's OWN profiles;
  # the round is its cartridge's, shared with the others that fire it.
  #
  # roundprofile IS SAFE TO NAME NOW. It resolved to a cartridge that carried its own `damage`,
  # which would have overridden Brutal Wolfenstein's numbers -- the owner's instruction for this
  # set. Every ww2_* cartridge now states `damage = none`, which the resolver reads as "the
  # weapon's number stands", so naming one takes the LOOK and leaves the shotdamage above alone.
  # Verified in RS_Ballistics/RSBDEFS.txt before wiring, on all seven.
  # 12 gauge
  roundprofile         = "ww2_12ga"
  flashprofile         = "ww2_trench"
  recoilprofile        = "ww2_trench"
  ejectaprofile        = "ww2_trench"
  # ---- WEIGHT ----------------------------------------------------------------
  # REAL: this IS that gun, and 7.50 lb is its published loaded weight.
  # 12ga 00 buck, nine pellets, total shot weight
  # EMPTY, NOT LOADED. 7.50 lb loaded less 8 rounds of 12 gauge 00 buck at 0.0991 lb each. A
  # magazine is not a rounding error -- a PPSh's 71-round drum is a seventh of the gun.
  baseweight           = 6.71
end

