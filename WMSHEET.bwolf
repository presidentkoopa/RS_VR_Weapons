# ==========================================================================
# WMSHEET.bwolf -- THE WW2 SET'S WEAPON CARDS.
#
# What each gun IS. How its parts MOVE is WMCARD.bwolf, the reload lane's, measured off the mesh.
#
# DAMAGE, SPREAD, PELLETS AND FIRE TICS ARE BRUTAL WOLFENSTEIN II v0.2.5's OWN, read out of
# its actors/Weapons/*.dec. Their numbers, our names, nothing invented. The owner's
# instruction, on their own private fork.
#
# THESE SUPERSEDE THE 5.0 NUMBERS THIS SHEET SHIPPED WITH. BWII rebalanced upward hard --
# the Kar98k went 40 -> 100, the Garand 30 -> 100, the BAR 30 -> 100, the StG 20 -> 40. The
# rifles are lethal now instead of chip damage, and the set is not the same set at the old
# numbers. Do not carry a 5.0 value forward into this file for any reason.
#
# THE AMMO TYPES ARE OURS AND ARE A JUDGEMENT, not a reading. Brutal Wolfenstein's own ammo
# classes -- WolfClip, MauserClip, M1CLIP, TGAMMO, PPSHReserve -- do not exist in our load order,
# and importing them would be importing their code, which is ruled out. Every gun is mapped onto
# Doom's own ammo so Doom's own pickups feed the set.
# ==========================================================================

gun "BW_MP40"
  class
    slot               = 4
    selectionorder     = 9400
    ammo               = "Clip"
    hand               = main
    name               = "MP40"
    pickupmessage      = "MP40"
  end
  firesound            = "bwolf/mp40/fire"
  # Brutal Wolfenstein II v0.2.5, actors/Weapons/MP40.dec
  shotdamage           = 20, 20
  shotspread           = 3, 3
  # FIRE CADENCE: the whole animation block that carries the shot, from its label to
  # A_Refire in Brutal Wolfenstein II's own state table. NOT the frame that fires: the
  # flash frame ahead of the bullet is part of the cycle, and counting from A_FireBullets
  # alone puts the MP40 at 11.7 shots a second against a real 500 rpm of 8.3. Counting the
  # block gives 8.75, and the Thompson lands on 11.7 against a real 700 rpm of 11.7.
  firetics             = 4
  # ALT-FIRE. A three-round burst at a tic faster than its own cadence. The MP40 is the baseline SMG and
  # a burst is the plainest discipline there is -- the gun that teaches the button.
  altmode              = burst
  altburst             = 3
  altbursttics         = 3
  # BALLISTICS (RS_Ballistics d1b4c06). flash, recoil and ejecta are this gun's OWN profiles;
  # the round is its cartridge's, shared with the others that fire it.
  #
  # roundprofile IS SAFE TO NAME NOW. It resolved to a cartridge that carried its own `damage`,
  # which would have overridden Brutal Wolfenstein's numbers -- the owner's instruction for this
  # set. Every ww2_* cartridge now states `damage = none`, which the resolver reads as "the
  # weapon's number stands", so naming one takes the LOOK and leaves the shotdamage above alone.
  # Verified in RS_Ballistics/RSBDEFS.txt before wiring, on all seven.
  # 9x19mm Parabellum
  roundprofile         = "ww2_9mm"
  flashprofile         = "ww2_mp40"
  recoilprofile        = "ww2_mp40"
  ejectaprofile        = "ww2_mp40"
  # ---- WEIGHT ----------------------------------------------------------------
  # REAL: this IS that gun, and 8.75 lb is its published loaded weight.
  # EMPTY, NOT LOADED. 8.75 lb loaded less 32 rounds of 9x19 / 5.56x45 at 0.0271 lb each. A
  # magazine is not a rounding error -- a PPSh's 71-round drum is a seventh of the gun.
  baseweight           = 7.88
end

gun "BW_STG44"
  class
    slot               = 5
    selectionorder     = 9520
    ammo               = "Clip"
    hand               = main
    name               = "StG 44"
    pickupmessage      = "StG 44"
  end
  firesound            = "bwolf/stg44/fire"
  # Brutal Wolfenstein II v0.2.5, actors/Weapons/STG44.dec
  shotdamage           = 40, 40
  shotspread           = 2, 2
  # FIRE CADENCE: the whole animation block that carries the shot, from its label to
  # A_Refire in Brutal Wolfenstein II's own state table. NOT the frame that fires: the
  # flash frame ahead of the bullet is part of the cycle, and counting from A_FireBullets
  # alone puts the MP40 at 11.7 shots a second against a real 500 rpm of 8.3. Counting the
  # block gives 8.75, and the Thompson lands on 11.7 against a real 700 rpm of 11.7.
  firetics             = 5
  # ALT-FIRE. The StG 44's own selector -- the first assault rifle, and the switch is the reason it is one.
  altmode              = selectfire
  altburst             = 3
  # BALLISTICS (RS_Ballistics d1b4c06). flash, recoil and ejecta are this gun's OWN profiles;
  # the round is its cartridge's, shared with the others that fire it.
  #
  # roundprofile IS SAFE TO NAME NOW. It resolved to a cartridge that carried its own `damage`,
  # which would have overridden Brutal Wolfenstein's numbers -- the owner's instruction for this
  # set. Every ww2_* cartridge now states `damage = none`, which the resolver reads as "the
  # weapon's number stands", so naming one takes the LOOK and leaves the shotdamage above alone.
  # Verified in RS_Ballistics/RSBDEFS.txt before wiring, on all seven.
  # 7.92x33mm Kurz
  roundprofile         = "ww2_792kurz"
  flashprofile         = "ww2_stg44"
  recoilprofile        = "ww2_stg44"
  ejectaprofile        = "ww2_stg44"
  # ---- WEIGHT ----------------------------------------------------------------
  # REAL: this IS that gun, and 10.20 lb is its published loaded weight.
  # EMPTY, NOT LOADED. 10.20 lb loaded less 30 rounds of 7.92x33 Kurz at 0.0370 lb each. A magazine
  # is not a rounding error -- a PPSh's 71-round drum is a seventh of the gun.
  baseweight           = 9.09
end

gun "BW_Tommy"
  class
    slot               = 4
    selectionorder     = 9410
    ammo               = "Clip"
    hand               = off
    name               = "Thompson M1A1"
    pickupmessage      = "Thompson M1A1"
  end
  firesound            = "bwolf/thompson/fire"
  # Brutal Wolfenstein II v0.2.5, actors/Weapons/Thompson.dec
  shotdamage           = 30, 30
  shotspread           = 3, 3
  # FIRE CADENCE: the whole animation block that carries the shot, from its label to
  # A_Refire in Brutal Wolfenstein II's own state table. NOT the frame that fires: the
  # flash frame ahead of the bullet is part of the cycle, and counting from A_FireBullets
  # alone puts the MP40 at 11.7 shots a second against a real 500 rpm of 8.3. Counting the
  # block gives 8.75, and the Thompson lands on 11.7 against a real 700 rpm of 11.7.
  firetics             = 3
  # ALT-FIRE. THE OWNER ASKED FOR THIS ONE BY NAME: "altfire is a more accurate single shot, semi auto".
  # selectfire steps single -> burst of three -> full auto, so single is the first press and
  # the accuracy is real rather than a modifier: one shot does not climb.
  altmode              = selectfire
  altburst             = 3
  # BALLISTICS (RS_Ballistics d1b4c06). flash, recoil and ejecta are this gun's OWN profiles;
  # the round is its cartridge's, shared with the others that fire it.
  #
  # roundprofile IS SAFE TO NAME NOW. It resolved to a cartridge that carried its own `damage`,
  # which would have overridden Brutal Wolfenstein's numbers -- the owner's instruction for this
  # set. Every ww2_* cartridge now states `damage = none`, which the resolver reads as "the
  # weapon's number stands", so naming one takes the LOOK and leaves the shotdamage above alone.
  # Verified in RS_Ballistics/RSBDEFS.txt before wiring, on all seven.
  # .45 ACP
  roundprofile         = "ww2_45"
  flashprofile         = "ww2_thompson"
  recoilprofile        = "ww2_thompson"
  ejectaprofile        = "ww2_thompson"
  # ---- WEIGHT ----------------------------------------------------------------
  # REAL: this IS that gun, and 10.80 lb is its published loaded weight.
  # EMPTY, NOT LOADED. 10.80 lb loaded less 30 rounds of .45 ACP at 0.0463 lb each. A magazine is
  # not a rounding error -- a PPSh's 71-round drum is a seventh of the gun.
  baseweight           = 9.41
end

