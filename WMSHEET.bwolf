gun "BW_Axe"
  class
    slot               = 1
    selectionorder     = 9110
    hand               = main
    name               = "Hatchet"
    pickupmessage      = "Hatchet"
  end
  firesound            = "bwolf/axe/fire"
  # Brutal Wolfenstein II v0.2.5, actors/Weapons/BDAXE.dec
  # BWII v0.2.5 uses A_Saw with a damage factor of 3 -- Doom's saw rolls factor*random(1,10),
  # so 3-30 a hit, averaging 16.5 -- at range 120, plus an AxeAttack projectile. The factor
  # goes to 10 (10-100) under PowerStrength. Swing cycle is 21 tics, 1.7/s.
  # MELEE WITH A THROWABLE SECONDARY -- the owner: "bw_axe is a melee wiuth a secondary of a
  # throwable". It swings in your hand and it leaves it, and neither half is the whole weapon.
  #
  # THE FIRST CALLER OF altmode = thrown, which did not exist this morning. All seven other alt
  # modes are disciplines for spending a round; a throw is not a shot, so it does not go through
  # the fire path at all. throwtics is a WIND-UP: hold the button that long before it can go, so a
  # twitch is not a throw.
  #
  # WHAT LEAVES YOUR HAND IS BW_ThrownAxe, which tumbles on the pitch your wrist actually turned
  # and hits as hard as you threw it.
  altmode              = thrown
  throwclass           = "BW_ThrownAxe"
  throwtics            = 18
end

gun "BW_Flamethrower"
  class
    slot               = 7
    selectionorder     = 9700
    ammo               = "Cell"
    hand               = main
    name               = "Flammenwerfer"
    pickupmessage      = "Flammenwerfer"
  end
  firesound            = "bwolf/flame/fire"
  # Brutal Wolfenstein II v0.2.5, actors/Weapons/Flamethrower.dec
  # BWII v0.2.5 fires FlamethrowerMissile, Damage (random(12,12)) -- a flat 12 -- at speed 35.
  # It is a projectile stream, not hitscan, so it carries no spread or pellet count.
  # BALLISTICS. THIS GUN HAS ONE PROFILE AND ONLY ONE, which is why it reads differently from
  # every other block in this sheet. NO roundprofile: it fires a flame, not a cartridge, so there
  # is no round for a cartridge profile to describe.
  #
  # NO flashprofile AND NO ejectaprofile, deliberately: neither exists for this gun and
  # neither should. The flame already owns the light, so a muzzle flash on top doubles it,
  # and nothing is ejected from a pressurised tank. The recoil is a steady shove rather
  # than a snap, because the tank pushes for as long as the trigger is held.
  recoilprofile        = "ww2_flame"
end

gun "BW_Grenade"
  class
    slot               = 9
    selectionorder     = 9900
    hand               = main
    name               = "Stielhandgranate"
    pickupmessage      = "Stielhandgranate"
  end
  firesound            = "bwolf/grenade/fire"
  # Brutal Wolfenstein II v0.2.5, actors/Weapons/BWGUN.dec
  # BWII v0.2.5's BWPlayerGranate is a three-ring blast, all in one tic:
  # A_Explode(120,160) then A_Explode(120,250) then A_Explode(60,320).
  # Fuse is GrenadeTime 3 over a 6-frame 2-tic loop -- 36 tics, almost exactly one second --
  # and it bounces at speed 20. Ours is 90@96 + 35@192, so BW's is far bigger in both rings.
end

gun "BW_P38"
  class
    slot               = 2
    selectionorder     = 9230
    ammo               = "Clip"
    hand               = main
    name               = "Walther P38"
    pickupmessage      = "Walther P38"
  end
  # Brutal Wolfenstein II v0.2.5, actors/Weapons/P38.dec -- READ, not inferred. Its WaltherP38 is
  # a real class in the roster and these are its own numbers, measured the same way as the other
  # sixteen: damage and spread off A_FireBullets, cadence off the animation block carrying the shot.
  #
  # IDENTICAL TO THE LUGER ON EVERY NUMBER, and that is the reading rather than a shortcut: both are
  # 9x19mm service pistols, BWII gives both 20 damage on a 6-tic cycle, and a P38 that differed
  # would be us inventing a distinction its own source does not make. Where they differ is the
  # magazine and the action, which are the card's.
  shotdamage           = 20, 20
  shotspread           = 1, 1
  firetics             = 6
  firesound            = "bwolf/p38/fire"
  roundprofile         = "ww2_9mm"
  flashprofile         = "ww2_p38"
  recoilprofile        = "ww2_p38"
  ejectaprofile        = "ww2_p38"
  # ---- WEIGHT ----------------------------------------------------------------
  # REAL: this IS that gun, and 1.80 lb is its published loaded weight.
  # EMPTY, NOT LOADED. 1.80 lb loaded less 8 rounds of 9x19 / 5.56x45 at 0.0271 lb each. A magazine
  # is not a rounding error -- a PPSh's 71-round drum is a seventh of the gun.
  baseweight           = 1.58
end

gun "BW_Nebelwerfer"
  class
    slot               = 8
    selectionorder     = 9800
    ammo               = "RocketAmmo"
    hand               = main
    name               = "Nebelwerfer"
    pickupmessage      = "Nebelwerfer"
  end
  # Brutal Wolfenstein II v0.2.5, actors/Weapons/NebelWerfer.dec.
  #
  # NO shotdamage AND NO shotspread, DELIBERATELY: it is not hitscan. It fires NebRocket, which
  # inherits Rocket2 -- Damage (random(150,150)), a flat 150 -- at Speed 80, and the damage lives on
  # the projectile rather than on the shot. A shotdamage row here would be a number the gun never
  # reads, which is the invented-shape trap from the other end.
  #
  # FIRETICS 4 IS READ off its fire block, and it is fast on purpose: the card gives it a capacity
  # of TWO because the model is a twin tube, so this is how quickly the second rocket follows the
  # first rather than a sustained rate. After two it reloads.
  firetics             = 4
  firesound            = "bwolf/nebelwerfer/fire"
  #
  # NO roundprofile: it fires a rocket, not a cartridge, so there is no round for one to describe.
  # NO ejectaprofile: nothing is ejected from a launch tube, and `ejecta ww2_nebelwerfer` does not
  # exist -- I checked the PACKED ballistics rather than its source tree. Flash and recoil do.
  flashprofile         = "ww2_nebelwerfer"
  recoilprofile        = "ww2_nebelwerfer"
  # MEASURED CLEAN AND STATED ANYWAY: 0 casings over 3 shots in a level, 2026-09-20.
  # Its card has an `ejectport`, so it is one default away from throwing brass. A gun that
  # happens to be right reads exactly like a gun that is right on purpose.
  ejectaprofile        = "none"
end


# ==========================================================================
# THE LEFT-HAND ARSENAL -- the same guns, for the WW2 set's off hand.
#
# The owner, 2026-09-19: pick the BWolf set and you play BWolf. Pick the WW2 set and you
# play WW2, with these in your left hand.
#
# A GUN'S HAND IS DECIDED WHEN ITS CLASS LOADS and cannot change in play, so a right-hand
# gun needs a twin rather than a flag. Each of these BORROWS ITS ORIGINAL'S MODEL CARD --
# `model = BW_MP40` -- so it is the same mesh, the same parts, the same magazine, the same
# sounds and the same numbers. Only the hand differs. No new art exists for any of them.
#
# THE THOMPSON, LUGER AND KNIFE HAVE NO TWIN because they are already off-hand guns. A
# second copy would put the same weapon in the list twice.
#
# SELECTION ORDER IS THE ORIGINAL'S PLUS ONE so a twin sorts immediately after the gun it
# copies rather than landing on another gun's number.
# ==========================================================================

gun "BW_MP40_Off"
  model                = BW_MP40
  class
    slot               = 4
    selectionorder     = 9401
    ammo               = "Clip"
    hand               = off
    name               = "MP40 (left)"
    pickupmessage      = "MP40"
  end
  # THE RIGHT HAND'S BRASS. This gun borrows MP40's model card, so it ejects from the
  # same port -- and stated nothing, so it threw the HOUSE DEFAULT while the right hand
  # threw the gun's own. One gun, two kinds of brass, decided by which hand held it.
  ejectaprofile        = "ww2_mp40"
end

