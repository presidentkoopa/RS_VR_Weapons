gun "BW_PPSh"
  class
    slot               = 4
    selectionorder     = 9420
    ammo               = "Clip"
    hand               = main
    name               = "PPSh-41"
    pickupmessage      = "PPSh-41"
  end
  firesound            = "bwolf/ppsh/fire"
  # Brutal Wolfenstein II v0.2.5, actors/Weapons/PPSH41.dec
  shotdamage           = 20, 20
  shotspread           = 4, 5
  # FIRE CADENCE: the whole animation block that carries the shot, from its label to
  # A_Refire in Brutal Wolfenstein II's own state table. NOT the frame that fires: the
  # flash frame ahead of the bullet is part of the cycle, and counting from A_FireBullets
  # alone puts the MP40 at 11.7 shots a second against a real 500 rpm of 8.3. Counting the
  # block gives 8.75, and the Thompson lands on 11.7 against a real 700 rpm of 11.7.
  firetics             = 2
  # ALT-FIRE. The PPSh-41 HAS a real fire selector, so this is the gun rather than an invention. It also
  # needs one more than anything else in the set: 71 rounds at 17.5 a second is four seconds
  # of trigger and an empty drum.
  altmode              = selectfire
  altburst             = 3
  # BALLISTICS (RS_Ballistics d1b4c06). flash, recoil and ejecta are this gun's OWN profiles;
  # the round is its cartridge's, shared with the others that fire it.
  #
  # roundprofile IS SAFE TO NAME NOW. It resolved to a cartridge that carried its own `damage`,
  # which would have overridden Brutal Wolfenstein's numbers -- the owner's instruction for this
  # set. Every ww2_* cartridge now states `damage = none`, which the resolver reads as "the
  # weapon's number stands", so naming one takes the LOOK and leaves the shotdamage above alone.
  # Verified in RS_Ballistics/RSBDEFS.txt before wiring, on all seven.
  # 7.62x25mm Tokarev
  roundprofile         = "ww2_762tok"
  flashprofile         = "ww2_ppsh"
  recoilprofile        = "ww2_ppsh"
  ejectaprofile        = "ww2_ppsh"
  # ---- WEIGHT ----------------------------------------------------------------
  # REAL: this IS that gun, and 12.00 lb is its published loaded weight.
  # EMPTY, NOT LOADED. 12.00 lb loaded less 71 rounds of 7.62x25 Tokarev at 0.0239 lb each. A
  # magazine is not a rounding error -- a PPSh's 71-round drum is a seventh of the gun.
  baseweight           = 10.30
end

gun "BW_BAR"
  class
    slot               = 5
    selectionorder     = 9530
    ammo               = "Clip"
    hand               = main
    name               = "BAR"
    pickupmessage      = "BAR"
  end
  firesound            = "bwolf/bar/fire"
  # Brutal Wolfenstein II v0.2.5, actors/Weapons/BAR.dec
  shotdamage           = 100, 100
  shotspread           = 5, 5
  # FIRE CADENCE: the whole animation block that carries the shot, from its label to
  # A_Refire in Brutal Wolfenstein II's own state table. NOT the frame that fires: the
  # flash frame ahead of the bullet is part of the cycle, and counting from A_FireBullets
  # alone puts the MP40 at 11.7 shots a second against a real 500 rpm of 8.3. Counting the
  # block gives 8.75, and the Thompson lands on 11.7 against a real 700 rpm of 11.7.
  firetics             = 5
  # ALT-FIRE. The BAR's real selector was slow auto against fast auto, 300 rpm against 550. Ours steps
  # single / burst / auto instead, which is the same idea in the vocabulary we have.
  altmode              = selectfire
  altburst             = 3
  # BALLISTICS (RS_Ballistics d1b4c06). flash, recoil and ejecta are this gun's OWN profiles;
  # the round is its cartridge's, shared with the others that fire it.
  #
  # roundprofile IS SAFE TO NAME NOW. It resolved to a cartridge that carried its own `damage`,
  # which would have overridden Brutal Wolfenstein's numbers -- the owner's instruction for this
  # set. Every ww2_* cartridge now states `damage = none`, which the resolver reads as "the
  # weapon's number stands", so naming one takes the LOOK and leaves the shotdamage above alone.
  # Verified in RS_Ballistics/RSBDEFS.txt before wiring, on all seven.
  # .30-06 Springfield
  roundprofile         = "ww2_3006"
  flashprofile         = "ww2_bar"
  recoilprofile        = "ww2_bar"
  ejectaprofile        = "ww2_bar"
  # ---- WEIGHT ----------------------------------------------------------------
  # REAL: this IS that gun, and 16.00 lb is its published loaded weight.
  # EMPTY, NOT LOADED. 16.00 lb loaded less 20 rounds of .30-06 at 0.0573 lb each. A magazine is
  # not a rounding error -- a PPSh's 71-round drum is a seventh of the gun.
  baseweight           = 14.85
end

