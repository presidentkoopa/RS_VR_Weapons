# ==========================================================================
# BLOOD / ZBLOODY HELL -- Caleb's arsenal -- carded.
#
# GENERATED. Edit the pipeline, never this file:
#   1. rebuild/prep_wm.py       _wm copies at each gun's own REST frame, every
#                               moving surface named into card_skeleton's vocabulary
#   2. rebuild/measure_all.py   tools/card_skeleton.py measures them
#   3. rebuild/assemble.py      chooses, on those measurements, and writes this
#
# PARTS ARE ADDRESSED BY NAME, because step 1 names every surface. An earlier
# attempt addressed them by INDEX and silently bound nothing on any of the sixteen.
#
# REST FRAMES ARE NOT FRAME 0 ON THIS SET: most idle at frame 5, the Garand at 4,
# the Kar98 at 7. A number taken at frame 0 is taken in a pose the gun is never in.
#
# HINGES ARE PARTS. A folding stock, a top cover or a break-open barrel turns about
# a pivot inside itself and moves its centre of mass almost not at all, so anything
# that asks "how far did it travel" loses all of them.
#
# EVERY GRAB POINT IS MEASURED, NOT HELD. They are places on a shape until the
# owner puts the gun in a hand.
# ==========================================================================


# ------------------------------------------------------------------------
# BL_FlareGun
# ------------------------------------------------------------------------
weapon "BL_FlareGun"
  hand       = main
  type       = pistol
  magfamily  = "flare"
  rackresetsound = "blood/flaregun/cock"
  prop       = "BL_PropFlareGun"
  model      = "models/blood/flaregun" "flaregun_wm.md3"
  skin       = "models/blood/flaregun" "flaregun.png"    # the shader this mesh names

  capacity   = 1

# THE MUZZLE: ESTIMATE, WHICH OPENING: the front face (x 12.75) has 4 openings along z (z -0.69..-0.30; z 0.56..0.80; z 1.41..2.27; z 3.09..5.08); the one with most vertices.
  muzzle     = 12.75, -0.02, 4.09
  barrel     = 0.9958,-0.0041,0.0913

# ESTIMATE, POINT AND SIDE: beside the action, on the side its handle rides.
  ejectport  = -2.00, 2.30, -2.07
  ejectdir   = -0.3, 0.9, 0.4

# THE SHOT AND THE SOUNDS are the class's and the owner's picks: silent until stated.
  mechanism  = breakaction
  # THE LOOSE ROUND: what the off hand brings to the open breech.
  roundmodel = "models/shared/shell" "shell.md3"
  roundskin  = "models/shared/shell" "shell.png"
  roundscale = 0.228
end

# THE ACTION (named by prep_wm.py from measured motion, not from the mesh's own label). STILL: nothing moves it on the donor's frames.
# TRAVEL NOT MEASURABLE HERE: the fit found only 1.000 of motion on this part, which is noise rather than a stroke,
# and sweeping it backwards through its own receiver reads as zero.
# 6.784 is the owner's headset-confirmed travel for the same class of action (WM_M4A3 slide),
# carried across rather than invented. It wants his pass on this gun.
# the artist called this surface `flaregun_trigger_guard`
part barrels
  role       = action
  subject    = slide
  surface    = bolt
  grab       = -3.95, 0.02, -2.16    # the rear end: ESTIMATE, where a hand pulls it
  grabradius = 3.0
  dof
    kind     = slide
    axis     = -1, 0, 0
    distance = 6.784    # ESTIMATE: no frame moves it
    detach   = 0.95
  end
end

# IT BREAKS OPEN AND TAKES ITS ROUNDS ONE AT A TIME (archetype breakaction).
# The chambers ARE the magazine on this weapon; there is nothing to detach.
store chambers
  kind  = slotted
  slots = 1
end

# THE BREECH: the eject port, which is the same opening a fresh round
# goes into -- breaking the gun open is what exposes it.
load breech
  at  = -2.00, 2.30, -2.07
  dir = 0.3000, -0.9000, -0.4000
end


# ------------------------------------------------------------------------
# BL_LifeLeech
# ------------------------------------------------------------------------
weapon "BL_LifeLeech"
  hand       = main
  type       = plasma
  magfamily  = "leech"
  startsound = "blood/lifeleech/wake"
  prop       = "BL_PropLifeLeech"
  model      = "models/blood/lifeleech" "lifeleech_wm.md3"
  skin       = "models/blood/lifeleech" "lifeleech.png"    # the shader this mesh names

  capacity   = 30
  firesfrom  = magazine    # fired straight from the magazine: nothing racks
  casing     = none    # ESTIMATE: nothing racks, so nothing is thrown out

# THE MUZZLE: the front-most vertices (x 8.42), centred.
  muzzle     = 8.42, -0.05, -3.00
  barrel     = 0.9588,-0.0779,0.2732

# The loose magazine beside the mesh; magcenter is the mag surface's centroid in the gun's space.
  magmodel      = "models/blood/lifeleech" "lifeleech_mag.md3"
  magskin       = "models/blood/lifeleech" "lifeleech.png"    # the shader this mesh names
  magscale   = 0.340
  magcenter  = 5.40, 0.26, 3.30

# THE SHOT AND THE SOUNDS are the class's and the owner's picks: silent until stated.
end

# THE MAGAZINE (named by prep_wm.py from measured motion, not from the mesh's own label). THE AXIS IS MEASURED: no single slide or hinge fits the whole stroke (the magazine tilts as it leaves), so the axis is the direction its centre actually travelled by frame 14. Distance is its own length along that axis. REVIEW: worst fit 10.518 -- it does not move as one rigid piece on every frame.
part magazine
  role       = feed
  subject    = magazine
  take       = no    # out by its button, in by the hand carrying one
  surface    = mag
  grab       = 12.03, -0.06, -1.00    # the far end along its pull: the floorplate
  grabradius = 3.0
  dof
    kind     = slide
    axis     = 0.812, -0.0826, -0.5779
    distance = 12.440
    detach   = 0.9
  end
end

# MEASURED: the underside is flat at z -3.50 from x 2.3 to 2.3; its middle. ESTIMATE: where the other hand goes.
part support
  role    = support
  subject = support
  grab       = 2.34, -0.02, -3.50
  grabradius = 3.0
end


