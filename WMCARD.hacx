  ejectdir   = -0.3, 0.9, 0.4

# THE SHOT AND THE SOUNDS are the class's and the owner's picks: silent until stated.
end

# THE ACTION (named by prep_wm.py from measured motion, not from the mesh's own label). 7.849 along (-0.2561, -0.0019, -0.9667) at frame 9, 0.01 degrees of turn, fit 0.014.
# the artist called this surface `Untitled`
part bolt4
  role       = action
  subject    = slide
  surface    = bolt4
  grab       = 23.62, 11.18, 3.71    # the handle's tip: its 44 vertices within 0.5 of its outermost
  grabradius = 3.0
  dof
    kind     = slide
    axis     = -0.2561, -0.0019, -0.9667
    distance = 7.849
    detach   = 0.95
  end
end

# MEASURED: the underside is flat at z -10.81 from x 9.0 to 9.2; its middle. ESTIMATE: where the other hand goes.
part support
  role    = support
  subject = support
  grab       = 9.08, 0.08, -10.81
  grabradius = 3.0
end


