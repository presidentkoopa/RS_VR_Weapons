# ==========================================================================
# HACX -- Banjo Software's cyberpunk guns -- carded.
#
# GENERATED. Edit the pipeline, never this file:
#   1. rebuild/prep_wm.py       _wm copies at each gun's own REST frame, every
#                               moving surface named into card_skeleton's vocabulary
#   2. rebuild/measure_all.py   tools/card_skeleton.py measures them
#   3. rebuild/assemble.py      chooses, on those measurements, and writes this
#
# PARTS ARE ADDRESSED BY NAME, because step 1 names every surface. An earlier
# attempt addressed them by INDEX and silently bound nothing on any of the sixteen.
#
# REST FRAMES ARE NOT FRAME 0 ON THIS SET: most idle at frame 5, the Garand at 4,
# the Kar98 at 7. A number taken at frame 0 is taken in a pose the gun is never in.
#
# HINGES ARE PARTS. A folding stock, a top cover or a break-open barrel turns about
# a pivot inside itself and moves its centre of mass almost not at all, so anything
# that asks "how far did it travel" loses all of them.
#
# EVERY GRAB POINT IS MEASURED, NOT HELD. They are places on a shape until the
# owner puts the gun in a hand.
# ==========================================================================


# ------------------------------------------------------------------------
# HX_Cryogun
# ------------------------------------------------------------------------
weapon "HX_Cryogun"
  hand       = main
  type       = plasma
  magfamily  = "hacx_cryo"
  maginsound = "hacx/common/reload4"
  magoutsound = "hacx/common/reload3"
  prop       = "HX_PropCryogun"
  model      = "models/hacx/cryogun" "cryogun_wm.md3"
  skin       = "models/hacx/cryogun" "cryogun.png"

  capacity   = 30

# THE MUZZLE: ESTIMATE, WHICH OPENING: the front face (x 46.72) has 2 openings along z (z -3.83..-3.83; z -1.56..-1.36); the upper one -- a pump's magazine tube runs under its barrel.
  muzzle     = 46.72, 0.00, -1.46
  barrel     = 0.9948,-0.0005,0.1019

# ESTIMATE, POINT AND SIDE: the receiver's +y side behind the forend. Pumps differ -- some eject downward.
  ejectport  = 1.64, 1.70, 4.27
  ejectdir   = -0.3, 0.9, 0.4

# The loose magazine beside the mesh; magcenter is the mag surface's centroid in the gun's space.
  magmodel      = "models/hacx/cryogun" "cryogun_mag.md3"
  magskin       = "models/hacx/cryogun" "cryogun.png"
  magscale   = 0.340
  magcenter  = -15.92, 0.00, 4.12

# THE SHOT AND THE SOUNDS are the class's and the owner's picks: silent until stated.
end

# THE MAGAZINE (named by prep_wm.py from measured motion, not from the mesh's own label). ESTIMATE, THE AXIS: no frame moves it, so its own long axis (the principal axis of its vertices). MEASURED, THE DIRECTION: the way along that axis that leads away from the body. Distance is its own length along that axis.
# the artist called this surface `mag_low`
part magazine
  role       = feed
  subject    = magazine
  take       = no    # out by its button, in by the hand carrying one
  surface    = mag
  grab       = -14.34, 0.00, 5.68    # the far end along its pull: the floorplate
  grabradius = 3.0
  dof
    kind     = slide
    axis     = 0.4953, -0.0067, 0.8687
    distance = 5.477
    detach   = 0.9
  end
end

# THE FOREND (named by prep_wm.py from measured motion, not from the mesh's own label). 9.999 along (-1, 0, 0) at frame 3, 0.01 degrees of turn, fit 0.008.
# the artist called this surface `body_low`
part forend
  subject    = forend
  surface    = forend
  grab       = 12.88, 0.00, -6.25    # the forend's centroid
  grabsize   = 3.9, 2.5, 2.5    # along: half its length in map units; across and up: ESTIMATE, room for a hand
  handseat   = 12.88, 0.00, -7.84    # ESTIMATE: where the hand sits -- the grab-point page trims it
  dof
    kind     = slide
    axis     = -1, 0, 0
    distance = 9.999
  end
end


