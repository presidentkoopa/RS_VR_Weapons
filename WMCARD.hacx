  model      = "models/hacx/uzi" "uzi_wm.md3"
  skin       = "models/hacx/uzi" "uzi.png"

  capacity   = 32

# THE MUZZLE: ESTIMATE, WHICH OPENING: the front face (x -9.70) has 2 openings along z (z -0.88..-0.33; z 0.64..0.64); the one with most vertices.
  muzzle     = -9.70, 0.00, -0.60
  barrel     = 0.9914,-0.0000,-0.1306

# ESTIMATE, POINT AND SIDE: beside the action, on the side its handle rides.
  ejectport  = 0.22, -1.75, 3.77
  ejectdir   = -0.3, -0.9, 0.4

# The loose magazine beside the mesh; magcenter is the mag surface's centroid in the gun's space.
  magmodel      = "models/hacx/uzi" "uzi_mag.md3"
  magskin       = "models/hacx/uzi" "uzi.png"
  magscale   = 0.340
  magcenter  = -7.95, -0.01, -4.18

# THE SHOT AND THE SOUNDS are the class's and the owner's picks: silent until stated.
end

# THE ACTION (named by prep_wm.py from measured motion, not from the mesh's own label). 6.002 along (1, 0, 0) at frame 4, 0.02 degrees of turn, fit 0.005.
# AXIS FLIPPED: it agreed with the bore, which racks this action FORWARDS.
# A slide, a bolt and a pump all travel back. Measured 1.000, 0.000, 0.000.
part bolt
  role       = action
  subject    = slide
  surface    = bolt
  grab       = -0.53, -1.75, 3.97    # the handle's tip: its 23 vertices within 0.5 of its outermost
  grabradius = 3.0
  dof
    kind     = slide
    axis     = -1.0000, -0.0000, -0.0000
    distance = 6.002
    detach   = 0.95
  end
end

# THE MAGAZINE (named by prep_wm.py from measured motion, not from the mesh's own label). 4.000 along (-1, 0, 0) at frame 9, 0.00 degrees of turn, fit 0.000. Distance is its own length along that axis.
# the artist called this surface `trigger`
part magazine
  role       = feed
  subject    = magazine
  take       = no    # out by its button, in by the hand carrying one
  surface    = mag6
  grab       = -5.08, 0.00, 5.73    # the far end along its pull: the floorplate
  grabradius = 3.0
  dof
    kind     = slide
    axis     = -1, 0, 0
    distance = 15.531
    detach   = 0.9
  end
end

# THE TRIGGER. 0.304 along (-0.0235, -0.0014, -0.9997) at frame 4, 0.30 degrees of turn, fit 0.007.
# the artist called this surface `Cylinder`
part trigger
  role    = trigger
  surface = trigger
  dof
    kind     = slide
    axis     = -0.0235, -0.0014, -0.9997
    distance = 0.304
  end
end


# ------------------------------------------------------------------------
# HX_Zooka
# ------------------------------------------------------------------------
weapon "HX_Zooka"
  hand       = main
  type       = launcher
  magfamily  = "hacx_bolt"
  loadsound  = "hacx/zooka/load"
  prop       = "HX_PropZooka"
  model      = "models/hacx/zooka" "zooka_wm.md3"
  skin       = "models/hacx/zooka" "Zooka.png"    # ESTIMATE: the first of 2 skins beside the mesh

  capacity   = 4

# THE MUZZLE: ESTIMATE, WHICH OPENING: the front face (x 14.22) has 3 openings along z (z -3.84..-3.22; z -0.39..-0.39; z 1.00..1.39); the one with most vertices.
  muzzle     = 14.22, 0.00, -3.53
  barrel     = 0.9994,0.0004,0.0349

# ESTIMATE, POINT AND SIDE: beside the round showing in the receiver, on the side its handle rides.
  ejectport  = -14.80, -2.31, 1.54
  ejectdir   = -0.3, -0.9, 0.4

# THE SHOT AND THE SOUNDS are the class's and the owner's picks: silent until stated.
  mechanism  = breakaction
  # THE LOOSE ROUND: what the off hand brings to the open breech.
  roundmodel = "models/hacx/zooka" "bolt.md3"
  roundskin  = "models/hacx/zooka" "bolt.png"
  roundscale = 1.000
end

# THE ACTION (named by prep_wm.py from measured motion, not from the mesh's own label). 152.16 degrees about the pin at -51.744, 4.110, 20.655 (frame 2, fit 0.016). Sign checked: +152.16 lands the rest centroid 31.709 off frame 2; -152.16 misses by 81.160.
# the artist called this surface `Bolt`
part barrels
  role       = action
  subject    = slide
  surface    = bolt4
  roundsurface = casing, chambers, 0    # REVIEW: it travels with the action -- a chambered round
  grab       = 26.88, -1.30, 1.56    # the handle's tip: its 55 vertices within 0.5 of its outermost
  grabradius = 3.0
  dof
    kind    = hinge
    axis    = -0.0026, -0.9781, 0.2081
    degrees = 152.16
    pivot   = -51.744, 4.110, 20.655
  end
end

# MEASURED: the underside is flat at z -3.84 from x 0.2 to 13.4; its middle. ESTIMATE: where the other hand goes.
part support
  role    = support
  subject = support
  grab       = 6.82, 0.00, -3.84
  grabradius = 3.0
end

# IT BREAKS OPEN AND TAKES ITS ROUNDS ONE AT A TIME (archetype breakaction).
# The chambers ARE the magazine on this weapon; there is nothing to detach.
store chambers
  kind  = slotted
  slots = 4
end

# THE BREECH: the eject port, which is the same opening a fresh round
# goes into -- breaking the gun open is what exposes it.
load breech
  at  = -14.80, -2.31, 1.54
  dir = 0.3000, 0.9000, -0.4000
end
