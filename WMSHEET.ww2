gun "WW2_Sten"
  class
    slot               = 4
    selectionorder     = 9410
    ammo               = "Clip"
    hand               = main
    name               = "Sten Mk II"
    pickupmessage      = "Sten Mk II"
  end
  firesound            = "wm/chaingun/fire"
  # A 9MM SMG, so the MP40's 20 -- RealRTCW rates it 7 against the MP40's 6 and the family ratio is
  # a clean 10/3, so this is a reading rather than a judgement.
  # Four tics: RealRTCW gives it 115 ms against the MP40's 110, which rounds to the same cadence.
  # Where it actually differs from the MP40 is its magazine and its 2.5 s reload, both on the card.
  shotdamage           = 20, 20
  shotspread           = 3, 3
  firetics             = 4
  roundprofile         = "ww2_9mm"
  flashprofile         = "ww2_sten"
  recoilprofile        = "ww2_sten"
  ejectaprofile        = "ww2_sten"
end

gun "WW2_MP34"
  class
    slot               = 4
    selectionorder     = 9420
    ammo               = "Clip"
    hand               = main
    name               = "MP34"
    pickupmessage      = "MP34"
  end
  firesound            = "wm/chaingun/fire"
  # 9mm SMG, so 20 -- RealRTCW rates it 6, identical to the MP40.
  # 105 ms against the MP40's 110, which is again the same cadence once it lands on whole tics.
  # Three 9mm SMGs sharing a number is honest: they ARE the same class of gun, and the set
  # separates them by magazine, reload and spread rather than by inventing damage differences.
  shotdamage           = 20, 20
  shotspread           = 3, 3
  firetics             = 4
  roundprofile         = "ww2_9mm"
  flashprofile         = "ww2_mp34"
  recoilprofile        = "ww2_mp34"
  ejectaprofile        = "ww2_mp34"
end

