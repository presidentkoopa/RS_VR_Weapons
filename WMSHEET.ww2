gun "WW2_TT33"
  class
    slot               = 2
    selectionorder     = 9220
    ammo               = "Clip"
    hand               = main
    name               = "TT-33 Tokarev"
    pickupmessage      = "TT-33 Tokarev"
  end
  firesound            = "wm/m4a3/fire"
  # RealRTCW tt33.weap 9 -- the same as the Colt, so 9 x 10/3 = 30 exactly.
  # SEVEN TICS, NOT THE COLT'S SIX: RealRTCW gives it 350 ms against the Colt's 300, so it is
  # scaled 6 x 350/300. The one place this set's pistols differ from each other in cadence.
  shotdamage           = 30, 30
  shotspread           = 1, 1
  firetics             = 7
  roundprofile         = "ww2_762tok"
  flashprofile         = "ww2_tt33"
  recoilprofile        = "ww2_tt33"
  ejectaprofile        = "ww2_tt33"
end

gun "WW2_HDM"
  class
    slot               = 2
    selectionorder     = 9230
    ammo               = "Clip"
    hand               = main
    name               = "HDM"
    pickupmessage      = "HDM"
  end
  firesound            = "wm/m4a3/slidefwd"
  # RealRTCW hdm.weap 8 x 10/3 = 26.7, ROUNDED TO 25 to sit on a round number between the Luger's
  # 20 and the Colt's 30 -- which is exactly where RealRTCW places it (6, 8, 9).
  # TIGHTEST SPREAD IN THE SET at 250 against the Luger's 400, which is the whole point of a
  # silenced assassination pistol.
  shotdamage           = 25, 25
  shotspread           = 1, 1
  firetics             = 6
  roundprofile         = "ww2_22lr"
  flashprofile         = "ww2_hdm"
  recoilprofile        = "ww2_hdm"
  ejectaprofile        = "ww2_hdm"
end

