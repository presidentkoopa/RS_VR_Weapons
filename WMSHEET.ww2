  # SHARED WITH WW2: identical to WMSHEET.bwolf's BW_BAR.
  # THIS IS THE GUN THE TWO GAMES DISAGREE ABOUT MOST -- BWII calls it a rifle at 100, RealRTCW
  # calls it a support weapon at 15, a ratio of 6.67 against the set's modal 3.33. BWII's ladder
  # wins here because it is the one both sets are built on.
  shotdamage           = 100, 100
  shotspread           = 5, 5
  firetics             = 5
  roundprofile         = "ww2_3006"
  flashprofile         = "ww2_bar"
