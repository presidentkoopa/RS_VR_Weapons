gun "WW2_Mauser"
  class
    slot               = 5
    selectionorder     = 9540
    ammo               = "Clip"
    hand               = main
    name               = "Mauser Kar98k"
    pickupmessage      = "Mauser Kar98k"
  end
  firesound            = "wm/revolver/fire"
  # SHARED WITH WW2: identical to WMSHEET.bwolf's BW_Kar98. RealRTCW's mauser.weap IS the Kar98k.
  # PERFECTLY ACCURATE, 0,0 -- BWII gives the Kar98k no spread at all, and this set keeps that.
  shotdamage           = 100, 100
  shotspread           = 0, 0
  firetics             = 11
  roundprofile         = "ww2_792"
  flashprofile         = "ww2_kar98k"
  recoilprofile        = "ww2_kar98k"
  ejectaprofile        = "ww2_kar98k"
end

gun "WW2_Mosin"
  class
    slot               = 5
    selectionorder     = 9550
    ammo               = "Clip"
    hand               = main
    name               = "Mosin-Nagant"
    pickupmessage      = "Mosin-Nagant"
  end
  firesound            = "wm/revolver/fire"
  # A BOLT RIFLE, so the Kar98k's 100.
  # ONE TIC SLOWER THAN THE MAUSER: RealRTCW gives it 1400 ms against the Mauser's 1300, so 11
  # scales to 12. Also perfectly accurate -- RealRTCW rates it TIGHTER than the Mauser (300
  # against 400), so it cannot sensibly be looser here.
  shotdamage           = 100, 100
  shotspread           = 0, 0
  firetics             = 12
  # NO LONGER BORROWED. It ran on the Kar98k's profiles because no ww2_mosin and no
  # 7.62x54R cartridge existed; both do now, so it runs on its own. Rimmed and Russian,
  # and a genuinely lighter kick than the Mauser -- 15.0 ft-lb against the Kar98k's 18.2,
  # which is the difference the borrowed profile could not express.
  # Verified present in the PACKED RS_Ballistics.pk3, not its source tree.
  roundprofile         = "ww2_762x54r"
  flashprofile         = "ww2_mosin"
  recoilprofile        = "ww2_mosin"
  ejectaprofile        = "ww2_mosin"
end

