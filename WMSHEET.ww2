gun "WW2_Browning"
  class
    slot               = 6
    selectionorder     = 9610
    ammo               = "Clip"
    hand               = main
    name               = "Browning M1919"
    pickupmessage      = "Browning M1919"
  end
  firesound            = "wm/machinegun/fire"
  # SHARED WITH WW2: identical to WMSHEET.bwolf's BW_Chaingun, which is this same weapon --
  # the roster has our Chaingun drawn from the browning mesh and standing in for BWII's
  # BWGatling "Heavy Machine Gun".
  # RealRTCW browning.weap rates it 15, exactly level with its MG42, and BWII rates its two
  # belt guns level too (40 each). Both games agree these are the same tier, so it takes the
  # MG tier's 40. Cadence is BWII's BWGatling, 4 tics -- a tic slower than the MG42, which
  # RealRTCW agrees with (100 ms against 70).
  shotdamage           = 40, 40
  shotspread           = 8, 6
  firetics             = 4
  roundprofile         = "ww2_3006"
  flashprofile         = "ww2_heavymg"
  recoilprofile        = "ww2_heavymg"
  ejectaprofile        = "ww2_heavymg"
end
