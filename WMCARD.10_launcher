# ============================================================================
# WMCARD.10_launcher -- the model card library, archetype launcher: WM_RocketLauncher, WM_RPG, WM_RotaryLauncher.
# Moved from WMCARD.txt on 2026-09-14 with every line unchanged. Index and order: WMCARD.txt.
# ============================================================================

# ==========================================================================
# LIVE: the launchers family (WM_RocketLauncher, WM_RPG).
# WM_RocketLauncher re-carded 09-15 on the RPG's mesh (the owner: the Force Unleashed rocket launcher comes out
# of Vanilla and Vanilla+, and RS_Main's RS_GH_RocketLauncher is that mesh), loaded one rocket at a time into
# the front of the tube. The Force Unleashed launcher's and the RPG's measurements stay in _pending/ROCKET_CARDS.md.
# ==========================================================================

# ============================================================ ROCKET LAUNCHER -- MAIN HAND
# RS_Main's RS_GH_RocketLauncher (RPG.md3) is RS_ModelSwapper's RPG.md3 shifted whole (same triangles and UVs);
# its frame 5 is rpg_wm.md3 vertex for vertex (8482). So the Rocket Launcher draws the RPG's mesh -- surfaces
# body, trigger, drum, rocket1-7 -- and every mesh number below is WM_RPG's.
# THE OWNER'S RELOAD (09-15): no rack and no drum swap. The drum stays on and holds seven rockets, one a
# chamber. A hand pushes single rockets into the front of the tube, and the drum turns with the count, so the
# rocket just loaded always stands in the bore behind the tube it went down. The RPG keeps its drum swap.
#
# SCALE: MODELDEF Scale 1.0 x 0.34 = 0.34 map units per model unit.
weapon "WM_RocketLauncher"
  type      = launcher     # its hand-seat profile (the key landed in c688186)
  hand      = main
  prop      = "WM_PropRocketLauncher"
  model     = "models/launchers/RPG" "rpg_wm.md3"
  skin      = "models/launchers/RPG" "rpg.png"

  # SEVEN ROCKETS, one a chamber (the owner, 09-15).
  capacity  = 7
  # Its own family: a rocket drawn for this gun loads only here -- never a shell, nor the RPG's drum.
  magfamily = "rocket"

  # no chamber -- the trigger fires straight from the drum. No role = action part, no cycle.
  firesfrom = magazine
  # nothing is thrown out, so no ejectport.
  casing    = none
  # two-handed; `part support` below.
  hands     = 2

  # The tube's front ring (x 65.875), centred on the bore (y 3.25, z -1.33). The rockets' noses
  # point +x.
  muzzle    = 65.88, 3.25, -1.33
  barrel    = 1, 0, 0

  # ONE ROCKET, the drum's own rocket1, lying along x (the RPG's). 14.27 units = 4.9 map units.
  roundmodel = "models/launchers/RPG" "wm_rocket.md3"
  roundskin  = "models/launchers/RPG" "rpg.png"
  roundscale = 0.34

  firesound = "weapons/rocklf"
  drysound  = "wm/dry"
  loadsound = "wm/rocket/magin"
end

# THE DRUM'S ROCKETS: a counted store that never comes off.
store drum
  kind     = counted
  capacity = 7
  detach   = no
end

# THE DRUM and its seven rockets (rigid together on all 39 donor frames, fit <= 0.015). It never comes
# off, so it has no dof and no grab.
# THE DRUM TURNS WITH THE COUNT (index, below), WM_RPG's measured step: -51.43 degrees (a seventh of a
# turn, the donor's frames 4-7) about +x through the drum's axis, one step for every rocket short of
# seven. With seven in, rocket1 is in the bore. A shot turns the next rocket in; a rocket loaded turns
# the drum back a step, so the new one stands in the bore. The rockets show the count in firing order
# (a roundsurface on the counted store is drawn while it holds MORE than its number).
part drum
  role    = feed
  take    = no
  surface = drum
  roundsurface = rocket1, drum, 6
  roundsurface = rocket2, drum, 5
  roundsurface = rocket3, drum, 4
  roundsurface = rocket4, drum, 3
  roundsurface = rocket5, drum, 2
  roundsurface = rocket6, drum, 1
  roundsurface = rocket7, drum, 0
  index
    kind    = hinge
    axis    = 1, 0, 0
    pivot   = 3.636, -4.562, 2.026
    degrees = -51.43
  end
end

# ROCKETS GO IN AT THE FRONT OF THE TUBE: one rocket brought to the tube's front ring, on the bore, and
# pushed down it (-x). size is the oval's half-sizes in map units: a rocket is 4.9 long and 1.7 across.
load muzzle
  into    = drum
  subject = round
  at      = 65.88, 3.25, -1.33
  size    = 2.5, 2.5, 2.5
  dir     = -1, 0, 0
end

# A sliding trigger: 1.397 along (-1.000, 0, -0.011) at frame 8, 0.05 degrees, fit 0.007 (WM_RPG's).
part trigger
  role    = trigger
  surface = trigger
  dof
    kind     = slide
    axis     = -1, 0, -0.011
    distance = 1.397
  end
end

# The mesh has no forward grip, so the hand goes under the front tube, well ahead of the trigger guard (which
# ends at x 29) and short of the muzzle (65.9): the middle of that stretch. Measured 09-14: the tube's bottom
# is z -6.44 on y 1.67 to 4.83 (WM_RPG's).
part support
  role    = support
  subject = support
  grab       = 47.5, 3.25, -6.44
  grabradius = 3.0
end

# ======================================================================= RPG -- OFF HAND
# RS_ModelSwapper's rocket launcher (MS_RocketLauncher) as rpg_wm.md3: a SEVEN-CHAMBER DRUM on
# the tube, swapped whole. Rest frame 4 (frame 5 with the drum home, not mid-index). Surfaces
# body, trigger, drum, rocket1-7 (rocket1 in the bore, the rest in firing order). Every number
# measured in that mesh's space against the body; _pending/ROCKET_CARDS.md.
#
# SCALE: MODELDEF Scale 1.0 x 0.34 = 0.34 map units per model unit.
weapon "WM_RPG"
  type      = launcher     # its hand-seat profile (the key landed in c688186)
  hand      = off
  prop      = "WM_PropRPG"
  model     = "models/launchers/RPG" "rpg_wm.md3"
  skin      = "models/launchers/RPG" "rpg.png"

  # The owner's six-rocket magazine. The drum has seven chambers: see `part drum`.
  capacity  = 6
  # Its own family: a drum seats only here, never the RocketLauncher's rack.
  magfamily = "rocketdrum"

  # fires straight from the magazine.
  firesfrom = magazine
  # nothing is thrown out, so no ejectport.
  casing    = none
  # two-handed; `part support` below.
  hands     = 2

  # The tube's front ring (x 65.875), centred on the bore (y 3.25, z -1.33). The rockets'
  # noses point +x.
  muzzle    = 65.88, 3.25, -1.33
  barrel    = 1, 0, 0

  # THE LOOSE DRUM: drum + rocket1-7 lifted out, re-origined on their centroid and stood so
  # the out axis points down. magcenter is that centroid in the gun's space.
  magmodel  = "models/launchers/RPG" "wm_rpg_mag.md3"
  magskin   = "models/launchers/RPG" "rpg.png"
  magscale  = 0.34
  magcenter = 3.520, -4.660, 2.325

  # ONE ROCKET, this drum's own rocket1, lying along x. 14.27 units = 4.9 map units.
  roundmodel = "models/launchers/RPG" "wm_rocket.md3"
  roundskin  = "models/launchers/RPG" "rpg.png"
  roundscale = 0.34

  firesound    = "wm/rocket/rpg_fire"
  drysound     = "wm/dry"
  magoutsound  = "wm/rocket/rpg_magout"
  maginsound   = "wm/rocket/rpg_magin"
  magdropsound = "wm/magdrop/large"
end

# THE DRUM and its seven rockets, one part (rigid together on all 39 frames, fit <= 0.015).
# Axis: the drum's centroid over insert frames 29-33, relative to home -- (0, -0.944, 0.329),
# straight off the bore (the bore-to-drum-axis line is (0, -0.919, 0.395)). Distance: where the
# drum's footprint (outer radius 12.683) clears every body triangle in its x span, 10.75. detach
# 0.95 ESTIMATE.
# THE DRUM TURNS ON THE SHOT (index, below) and its rockets show the count (a roundsurface on the
# counted mag is drawn while it holds MORE than its number). They go in firing order: at 5 rocket1
# is gone and the drum has turned rocket2 into the bore, and so on to rocket6 at 1; at 0 the bore
# faces the seventh chamber, which is never loaded (part emptychamber, below).
part drum
  role    = feed
  subject = magazine
  take    = no          # out by its button, in by the hand carrying one
  surface = drum
  roundsurface = rocket1, mag, 5
  roundsurface = rocket2, mag, 4
  roundsurface = rocket3, mag, 3
  roundsurface = rocket4, mag, 2
  roundsurface = rocket5, mag, 1
  roundsurface = rocket6, mag, 0
  # The drum's outer rim on its out axis: the axis (y -4.562, z 2.026) plus 12.683 along
  # (0, -0.944, 0.329), at the drum's middle x. Radius 3.0: the house reach tolerance for the grab
  # page, not a mesh size.
  grab       = 3.64, -16.54, 6.20
  grabradius = 3.0
  dof
    kind     = slide
    axis     = 0, -0.944, 0.329
    distance = 10.75
    detach   = 0.95
  end
  # THE PER-SHOT TURN, measured from the donor's frames 4-7: -51.43 degrees (a seventh of a turn)
  # about +x through the drum's axis. Steps = clamp(6 - rounds, 0, 6), the defaults.
  index
    kind    = hinge
    axis    = 1, 0, 0
    pivot   = 3.636, -4.562, 2.026
    degrees = -51.43
  end
end

# THE SEVENTH CHAMBER STAYS EMPTY: capacity 6 in a seven-chamber drum. Hidden, not counted -- a
# count of 6 would never show. The loose drum (wm_rpg_mag.md3) carries no rocket7 either.
part emptychamber
  role    = hidden
  surface = rocket7
end

# A sliding trigger: 1.397 along (-1.000, 0, -0.011) at frame 8, 0.05 degrees, fit 0.007.
part trigger
  role    = trigger
  surface = trigger
  dof
    kind     = slide
    axis     = -1, 0, -0.011
    distance = 1.397
  end
end

# The mesh has no forward grip, so the hand goes under the front tube, well ahead of the trigger guard (which
# ends at x 29) and short of the muzzle (65.9): the middle of that stretch. Measured 09-14: the tube's bottom
# is z -6.44 on y 1.67 to 4.83 (the mesh has no vertices between x 36 and 58, only the tube's long faces).
part support
  role    = support
  subject = support
  grab       = 47.5, 3.25, -6.44
  grabradius = 3.0
end


# =================================================== ROTARY LAUNCHER -- OFF HAND
# MeatGrinder's RPG.md3 at frame 0 as rotarylauncher_wm.md3: surfaces body, tubes (six rockets in their
# rings), trigger, button. Shift (54.9375, 0.1250, -7.3281). The rotary gun's receiver carrying a cluster
# of six rocket tubes.
# THE ROCKETS COME FROM THE RESERVE: the tubes are fixed and nothing detaches, so it fires from
# Weapon.AmmoType1.
weapon "WM_RotaryLauncher"
  hand      = off
  type      = launcher
  prop      = "WM_PropRotaryLauncher"
  model     = "models/launchers/RotaryLauncher" "rotarylauncher_wm.md3"
  skin      = "models/launchers/RotaryLauncher" "RPG.png"

  firesfrom = reserve
  casing    = none
  hands     = 2

  # ESTIMATE, WHICH TUBE: the top one, 11.1 above the cluster's axis (y -0.35, z -1.68), at its front
  # (x 42.68). The rockets' noses point +x.
  muzzle    = 42.68, -0.32, 9.44
  barrel    = 1, 0, 0

  # This package's launcher sounds (SNDINFO wm/rocket/*).
  firesound = "wm/rocket/fire"
  drysound  = "wm/dry"
end

# 15.05 degrees about the pin at -20.125, 4.086 (source frame 6, fit 0.010). Sign checked: +15.05 lands the
# rest centroid 0.001 off frame 6; -15.05 misses by 1.583.
part trigger
  role    = trigger
  surface = trigger
  dof
    kind    = hinge
    axis    = 0, 1, 0
    degrees = 15.05
    pivot   = -20.125, 0, 4.086
  end
end

# THE OTHER HAND ON THE ANGLED FRONT HANDLE: its centroid, as the rotary gun's. ESTIMATE: where on it the
# hand goes.
part support
  role    = support
  subject = support
  grab       = -7.90, 3.92, 5.45
  grabradius = 3.0
end

# THE TUBES TURN AS IT FIRES: the donor turns every tube surface 45.0 degrees about +x over source frames
# 1-3 (fit 0.014 or better), about the cluster's axis through (y -0.35, z -1.68). Six tubes, so one period
# is 60 degrees. `spin = fire` turns it for one fire cycle after each shot; 3 degrees a tic over a vanilla
# rocket cycle of about 20 tics steps it about one tube a rocket. Rate ESTIMATE. Looks only.
part tubes
  surface  = tubes
  spin     = fire
  spinrate = 3
  spinup   = 0
  spindown = 0
  dof
    kind    = hinge
    axis    = 1, 0, 0
    pivot   = 0, -0.35, -1.68
    degrees = 60
  end
end
