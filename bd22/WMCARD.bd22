  barrel    = 1, 0, 0
  # side measured (420 vertices on -y against 389 on +y), the emptier wall of the receiver; the point and the direction are estimates
  ejectport = -2.252, 2.328, -2.437
  ejectdir  = -0.2914, 0.8742, 0.3885

  opensound      = "bd22/revolver/open"
  closesound     = "bd22/revolver/close"
  ejectsound     = "bd22/revolver/unload"
