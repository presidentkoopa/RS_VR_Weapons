# WMCARD.bd22 -- written by WeaponForge. Do not edit by hand:
# fix the tool or sets/bd22/set.py and run RUN_SET again.
weapon "BD_Pistol"
  hand      = main
  type      = pistol
  prop      = "BD_PropPistol"
  model     = "models/bd22" "pistol_wm.md3"
  skin      = "models/bd22" "pistol.png"
  capacity  = 15
  magfamily = "bd_9mm"

  muzzle    = 15.593, -0.000, 3.614
  barrel    = 1, 0, 0
  # side measured (286 vertices on -y against 292 on +y), the side away from the action; the point and the direction are estimates
  ejectport = -4.028, 1.656, 0.946
  ejectdir  = -0.2914, 0.8742, 0.3885

  magmodel  = "models/bd22" "pistol_magazine.md3"
  magskin   = "models/bd22" "pistol.png"
  magscale  = 0.34
  magcenter = -3.508, -0.036, -4.916

  magoutsound    = "bd22/pistol/magout"
  maginsound     = "bd22/pistol/magin"
  rackapexsound  = "bd22/pistol/slideback"
  rackresetsound = "bd22/pistol/slidefwd"
end

# THE GRIP: the point of this mesh that is in the palm (CardPipeline/GUN_IN_HAND_PLAN.md).
# 2026-10-01: this gun's own handle on the M4A3's grip (set.py FIRING_LINE "hand").
grip
  seat = -1.154, 0.070, 2.748
end

# WHERE THE OFF HAND GOES. The height is measured -- the underside of the
# body there. The length along the gun is an ESTIMATE: the middle of the
# body's thick run forward of the magazine, since a handguard is thick and
# a barrel is thin. Check it in the headset.
part support
  role    = support
  subject = support
  grab       = -0.539, 0.000, -10.609
  grabradius = 3.0
end

part bolt2
  role    = action
  subject = slide
  surface = bolt2
  grab       = -5.767, 0.130, 3.462
  grabradius = 3.0
  dof
    kind     = slide
    axis     = -1.000, -0.000, 0.000
    distance = 4.591
    detach   = 0.95
  end
end

part magazine
  role    = feed
  subject = magazine
  take    = no
  surface = magazine
  grab       = -4.225, -0.036, -10.181
  grabradius = 3.0
  dof
    kind     = slide
    axis     = -0.174, 0.000, -0.985
    distance = 13.285
    detach   = 0.9
  end
end

