# ==========================================================================
# RS_VR_BD22 -- THE WEAPON CARDS for Brutal Doom v22's guns in worldspace.
#
# What each gun IS. How its parts MOVE is WMCARD.bd22, measured off br_vr's meshes
# and their labelled reload frames.
#
# SELECTION ORDER IS 96xx, a band nothing else in the family uses.
# CAPACITIES match the model card's, which is where the reload system reads them.
# ==========================================================================

gun "BD_Pistol"
  class
    slot               = 2
    selectionorder     = 9601
    ammo               = "Clip"
    hand               = main
    name               = "Brutal Pistol"
    pickupmessage      = "Brutal Pistol"
  end
  capacity             = 15
  roundprofile         = "pistol_9mm"
  flashprofile         = "pistol_9mm"
  ejectaprofile        = "brass_9mm"
  recoilprofile        = "pistol_9mm"
  firesound            = "Pistol/Fire"
  shotdamage           = 14, 14        # BD's own, flat: every BD A_FireBullets is FBF_NORANDOM
  shotspread           = 1, 1
  firetics             = 11
  # BD22, measured from Brutal Doom's own DECORATE 2026-10-02: A_ReFire Pistol.dec:278
  fullauto             = yes
end

