gun "BD_FlameCannon"
  class
    slot               = 6
    selectionorder     = 9607
    ammo               = "Cell"
    hand               = main
    name               = "Flame Cannon"
    pickupmessage      = "Flame Cannon"
  end
  capacity             = 100
  # A FLAME IS NOT A BULLET: no roundprofile and no flashprofile. `napalm` and
  # `ww2_flame` are `flame` profiles, which the sheet reader has no key for, so the
  # flame is drawn by whatever throws it and not named here.
  recoilprofile        = "flamer_heavy"
  firetics             = 10
  # BD22, measured from Brutal Doom's own DECORATE 2026-10-02: Fireball path FlameCannon.dec:152
  fullauto             = yes
  firesound            = "Flamer/loop"       # the parent mod's own (Flamer2.ogg)
  shotclass            = "BigFireBallWithGravity"  # FlameCannon Fire; the 4x spray rides with it
end

