  recoilprofile        = "machinegun_762"
  firesound            = "Chaingun/Fire"
  shotdamage           = 20, 20        # NOT MG42's -- BD22 has NO machinegun class (its belt/rotary guns are MG42 and
                                    # MiniGun only). This mesh is BD v21's, which v22 dropped. Numbers are
                                    # BD's RIFLE: a magazine-fed rifle-calibre gun with an under-barrel
                                    # grenade launcher -- the same configuration. Ours, not BD's. Change freely.
  shotspread           = 1, 1
  firetics             = 2
end

