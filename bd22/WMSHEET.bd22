gun "BD_SSG"
  class
    slot               = 3
    selectionorder     = 9604
    ammo               = "Shell"
    hand               = main
    name               = "Super Shotgun"
    pickupmessage      = "Super Shotgun"
  end
  capacity             = 2
  roundprofile         = "buckshot_magnum"
  flashprofile         = "shotgun_ssg"
  ejectaprofile        = "hull_12ga_magnum"
  recoilprofile        = "shotgun_ssg"
  shotdamage           = 13, 13        # BD's own, flat: every BD A_FireBullets is FBF_NORANDOM
  shotpellets          = 9
  shotspread           = 10, 1
  firetics             = 59
  # BD22, measured from Brutal Doom's own DECORATE 2026-10-02: the only A_ReFire is at the END of the 47-tic auto-reload, SSG.dec:438
  fullauto             = yes
  # BOTH BARRELS ON ONE PULL, as Vanilla's WM_SSG has it (WMSHEET.shotguns). Left unset the
  # gun spends one chamber a pull: the second shell is NOT unreachable -- the next pull fires
  # it -- but a sawn-off double that needs two pulls to empty is the wrong gun.
  chambersperpull      = 2
  firesound            = "SSG/Fire"          # the parent mod's own (SSHFIRE.ogg)
end

