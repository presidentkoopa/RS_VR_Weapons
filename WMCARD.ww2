# ==========================================================================
# THE WW2 SET -- Brutal Wolfenstein's weapons, carded.
#
# GENERATED by tools/gen_ww2_set.py. Edit its table, not this file.
#
# Measured off the RE-ORIGINED copies in WW2_work/models -- centred on visible
# geometry at frame 0, packed normals byte-compared against the originals
# afterwards. A number from an un-re-origined copy is wrong by the length of the
# gun and must never be mixed in.
#
# Travel is the distance that CLEARS a part, not the distance its author
# animated. Parts are addressed by INDEX because half these meshes name every
# surface the same string, so each carries a fingerprint as well.
# ==========================================================================


# ------------------------------------------------------------------------
# WW2_MP40 -- MP40.md3, 7 surfaces, 10 frames. Body is surface 0 (MP40, 11685 verts).
# Magazine straight down 12.00. No bolt animated as its own piece.
# ------------------------------------------------------------------------
weapon "WW2_MP40"
  hand      = main
  type      = smg
  prop      = "WW2_PropMP40"
  model     = "models/ww2/MP40" "MP40.md3"
  body      = 0
  muzzle    = 35.034, -0.028, 2.859
  barrel    = 1, 0, 0
  # capacity from Actors/Weaps/MP40.txt (their number, our name)
  capacity  = 8
  part magazine
    role    = feed
    subject = magazine
    surface = 4
    # FINGERPRINT: 1214 verts, 22.45 across. A re-export that renumbers the
    # surfaces makes this index mean something else; these two numbers are
    # what a loader checks so that failure is loud instead of a mystery.
    fingerprint = 1214, 22.45
    grab       = 7.053, -0.014, -22.000
    grabradius = 3.0
    dof
      kind     = slide
      axis     = 0.000, 0.000, -1.000
      # The author animates 12.00 (peaking at frame 9); a hand drives until
      # the part is CLEAR, which is 13.02.
      distance = 13.02
      detach   = 0.9
    end
  end
end

