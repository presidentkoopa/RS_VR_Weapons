# ==========================================================================
# REALRTCW -- shared source for the BWolf and Complete WW2 sets -- carded.
#
# GENERATED. Edit the pipeline, never this file:
#   1. rebuild/prep_wm.py       _wm copies at each gun's own REST frame, every
#                               moving surface named into card_skeleton's vocabulary
#   2. rebuild/measure_all.py   tools/card_skeleton.py measures them
#   3. rebuild/assemble.py      chooses, on those measurements, and writes this
#
# PARTS ARE ADDRESSED BY NAME, because step 1 names every surface. An earlier
# attempt addressed them by INDEX and silently bound nothing on any of the sixteen.
#
# REST FRAMES ARE NOT FRAME 0 ON THIS SET: most idle at frame 5, the Garand at 4,
# the Kar98 at 7. A number taken at frame 0 is taken in a pose the gun is never in.
#
# HINGES ARE PARTS. A folding stock, a top cover or a break-open barrel turns about
# a pivot inside itself and moves its centre of mass almost not at all, so anything
# that asks "how far did it travel" loses all of them.
#
# EVERY GRAB POINT IS MEASURED, NOT HELD. They are places on a shape until the
# owner puts the gun in a hand.
# ==========================================================================


# ------------------------------------------------------------------------
# WW2_BAR
# ------------------------------------------------------------------------
weapon "WW2_BAR"
  hand       = main
  type       = rifle
  magfamily  = "bar"
  drysound   = "wm/dry"
  maginsound = "wm/rifle/magin"
  magoutsound = "wm/rifle/magout"
  rackapexsound = "wm/rifle/rackback"
  rackresetsound = "wm/rifle/rackfwd"
  prop       = "BW_PropWW2_BAR"
  model      = "models/ww2/bar" "bar_wm.md3"
  # modelscale = 1.321
  skin       = "models/ww2/bar" "wpn_base.jpg"    # the shader this mesh names

  capacity   = 20

# THE MUZZLE: the front-most vertices (x 66.80), centred.
  muzzle     = 66.80, 0.05, 2.70
  barrel     = 0.9993,0.0021,0.0375

# ESTIMATE, POINT AND SIDE: beside the action, on the side its handle rides.
  ejectport  = -4.61, 2.48, 0.31
  ejectdir   = -0.3, 0.9, 0.4

# The loose magazine beside the mesh; magcenter is the mag surface's centroid in the gun's space.
  magmodel      = "models/ww2/bar" "bar_mag.md3"
  magskin       = "models/ww2/bar" "wpn_base.jpg"    # the shader this mesh names
  magscale   = 0.449
  magcenter  = -1.49, -0.50, -5.56

# THE SHOT AND THE SOUNDS are the class's and the owner's picks: silent until stated.
end

# THE ACTION (named by prep_wm.py from measured motion, not from the mesh's own label). 8.892 along (-0.9995, 0.0311, -0.0031) at frame 67, 0.19 degrees of turn, fit 0.011.
# the artist called this surface `part4`
part bolt
  role       = action
  subject    = slide
  surface    = bolt
  grab       = -4.31, 2.96, 0.20    # the handle's tip: its 58 vertices within 0.5 of its outermost
  grabradius = 3.0
  dof
    kind     = slide
    axis     = -0.9995, 0.0311, -0.0031
    distance = 8.892
    detach   = 0.95
  end
end

# THE MAGAZINE (named by prep_wm.py from measured motion, not from the mesh's own label). THE AXIS IS MEASURED: no single slide or hinge fits the whole stroke (the magazine tilts as it leaves), so the axis is the direction its centre actually travelled by frame 107. Distance is its own length along that axis.
# the artist called this surface `part2`
part magazine
  role       = feed
  subject    = magazine
  take       = no    # out by its button, in by the hand carrying one
  surface    = mag
  grab       = -4.72, -1.73, -14.23    # the far end along its pull: the floorplate
  grabradius = 3.0
  dof
    kind     = slide
    axis     = -0.1396, -0.3039, -0.9424
    distance = 13.167
    detach   = 0.9
  end
end

# MEASURED: the underside is flat at z -0.34 from x 46.2 to 49.5; its middle. ESTIMATE: where the other hand goes.
part support
  role    = support
  subject = support
  grab       = 47.88, -0.15, -0.34
  grabradius = 3.0
end


