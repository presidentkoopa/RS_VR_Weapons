# ============================================================================
# RS_VR_Weapons, VANILLA+ -- THE EXTRAS' WEAPON CARDS (WMSHEET.plus_extras).
#
# The Vanilla+ guns that are not versions of a Vanilla gun: each uses its own Model Card (the card with its class's
# name) and keeps its class's Default for every number not stated here. Tuning with the owner, 09-15: "I can fire a semi
# auto weapon about six times per second ... Pistol, Revolver, Rifle, one shot per pull. Can pull up to six times per
# second" -- firetics 6 (35 / 6 = 5.8 a second), one shot per pull. Both rifles start in single fire (the owner: "both guns?
# start in single fire, up to six shots per second"); their alt fire will cycle single -> 3-round burst -> full auto.
# ============================================================================

gun "WM_Moonlight"
  firetics             = 6
  altmode              = fan
  altfanmax            = 8
  spreadshape          = cone
  # BALLISTICS (RS_Ballistics 53F95E6). Its own look, not the house recipe -- these seven
  # shared one muzzle flash and one brass between them because they named nothing.
  # NO ejectaprofile, and there is no `ejecta vp_moonlight` to name: a revolver holds its
  # brass in the cylinder until you dump all six.
  flashprofile         = "vp_moonlight"
  recoilprofile        = "vp_moonlight"
  roundprofile         = "revolver_357"
  # ---- WEIGHT ----------------------------------------------------------------
  # ANALOGUE: the POUND is measured, the PAIRING is a judgement. a .357 service revolver -- fan
  # alt-fire and eight shots say revolver, and a long barrel says it is the tidier of the pair
  # Argue with the pairing, not the number -- if this is the wrong real-world gun to stand in for,
  # say so and the weight follows.
  # EMPTY, NOT LOADED. 2.60 lb loaded less 6 rounds of .357 Magnum at 0.0397 lb each. A magazine is
  # not a rounding error -- a PPSh's 71-round drum is a seventh of the gun.
  baseweight           = 2.36
  # MEASURED CLEAN AND STATED ANYWAY: 0 casings over 8 shots in a level, 2026-09-20.
  # Its card has an `ejectport`, so it is one default away from throwing brass. A gun that
  # happens to be right reads exactly like a gun that is right on purpose.
  ejectaprofile        = "none"
end

gun "WM_Sunset"
  firetics             = 6
  altmode              = fan
  altfanmax            = 8
  spreadshape          = cone
  # BALLISTICS (RS_Ballistics 53F95E6). Its own look, not the house recipe -- these seven
  # shared one muzzle flash and one brass between them because they named nothing.
  # NO ejectaprofile, and there is no `ejecta vp_sunset` to name: a revolver holds its
  # brass in the cylinder until you dump all six.
  flashprofile         = "vp_sunset"
  recoilprofile        = "vp_sunset"
  roundprofile         = "revolver_357"
  # ---- WEIGHT ----------------------------------------------------------------
  # ANALOGUE: the POUND is measured, the PAIRING is a judgement. the heavier twin: a .44 Magnum, so
  # it hits harder and rises further than the Moonlight and reads as its opposite number
  # Argue with the pairing, not the number -- if this is the wrong real-world gun to stand in for,
  # say so and the weight follows.
  # No ammunition subtracted: this gun's card states no capacity, so 3.10 lb is the figure as given
  # and may still carry a load.
  baseweight           = 3.10
end

gun "WM_ColaRevolver"
  firetics             = 6
  altmode              = fan
  altfanmax            = 8
  spreadshape          = cone
  # BALLISTICS (RS_Ballistics 53F95E6). Its own look, not the house recipe -- these seven
  # shared one muzzle flash and one brass between them because they named nothing.
  # NO ejectaprofile, and there is no `ejecta vp_colarevolver` to name: a revolver holds its
  # brass in the cylinder until you dump all six.
  flashprofile         = "vp_colarevolver"
  recoilprofile        = "vp_colarevolver"
  roundprofile         = "revolver_357"
  # ---- WEIGHT ----------------------------------------------------------------
  # ANALOGUE: the POUND is measured, the PAIRING is a judgement. a short snub .357 -- lighter and
  # cruder than either, which is the joke in the name
  # Argue with the pairing, not the number -- if this is the wrong real-world gun to stand in for,
  # say so and the weight follows.
  # EMPTY, NOT LOADED. 2.20 lb loaded less 12 rounds of .357 Magnum at 0.0397 lb each. A magazine
  # is not a rounding error -- a PPSh's 71-round drum is a seventh of the gun.
  baseweight           = 1.72
end

gun "WM_Rifle"
  fullauto             = false
  firetics             = 6
  altmode              = selectfire
  altburst             = 3
  spreadshape          = cone
  # BALLISTICS (RS_Ballistics 53F95E6). Its own look, not the house recipe -- these seven
  # shared one muzzle flash and one brass between them because they named nothing.
  flashprofile         = "vp_rifle"
  recoilprofile        = "vp_rifle"
  ejectaprofile        = "vp_rifle"
  roundprofile         = "rifle_556"
  # ---- WEIGHT ----------------------------------------------------------------
  # ANALOGUE: the POUND is measured, the PAIRING is a judgement. a 5.56 service rifle, full length
  # Argue with the pairing, not the number -- if this is the wrong real-world gun to stand in for,
  # say so and the weight follows.
  # EMPTY, NOT LOADED. 8.00 lb loaded less 20 rounds of 9x19 / 5.56x45 at 0.0271 lb each. A
  # magazine is not a rounding error -- a PPSh's 71-round drum is a seventh of the gun.
  baseweight           = 7.46
end

